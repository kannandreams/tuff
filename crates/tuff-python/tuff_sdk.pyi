"""The Tuff SDK for Python: install, update, and remove capability packs."""

from os import PathLike
from pathlib import Path
from typing import Any, Literal, Optional, Sequence, Union

StrPath = Union[str, PathLike[str]]

__version__: str

class TuffError(Exception):
    """Any error from Tuff."""

    kind: str
    """The same kind as the `kind` field of the CLI's JSON errors."""
    hint: Optional[str]
    """The suggestion to show, or None."""

class UsageError(TuffError): ...
class NotFoundError(TuffError): ...
class RefusedError(TuffError): ...
class DriftError(TuffError): ...
class SourceError(TuffError): ...
class CorruptError(TuffError): ...
class UnsupportedError(TuffError): ...
class IoError(TuffError): ...
class InternalError(TuffError): ...
class PlanUsedError(TuffError): ...

class Baselines:
    """Where to keep a copy of each installed folder."""

    @staticmethod
    def dir(path: StrPath) -> Baselines: ...
    @staticmethod
    def in_workspace() -> Baselines: ...
    @staticmethod
    def none() -> Baselines: ...

class Pack:
    """A pack release, ready to plan."""

    @staticmethod
    def build(folder: StrPath, targets: Optional[Sequence[str]] = None) -> Pack: ...
    @staticmethod
    def read(path: StrPath) -> Pack: ...
    @staticmethod
    def checkout(
        url: str,
        targets: Sequence[str],
        ref: Optional[str] = None,
        path: Optional[str] = None,
        plugin: Optional[str] = None,
    ) -> Pack: ...
    @property
    def name(self) -> str: ...
    @property
    def version(self) -> str: ...
    @property
    def description(self) -> str: ...
    @property
    def digest(self) -> str: ...
    @property
    def notes(self) -> list[str]: ...
    @property
    def warnings(self) -> list[str]: ...
    def inspect(self) -> dict[str, Any]: ...

class Release:
    version: str
    digest: str

class PlanFile:
    path: str
    change: Literal["create", "modify", "delete"]

class PlanMember:
    id: str
    type: str
    version: Optional[str]
    change: Literal["add", "update", "remove"]

class _Summary:
    @property
    def operation(self) -> Literal["install", "update", "remove"]: ...
    @property
    def pack(self) -> str: ...
    @property
    def installed(self) -> Optional[Release]: ...
    @property
    def release(self) -> Optional[Release]: ...
    @property
    def targets(self) -> list[str]: ...
    @property
    def members(self) -> list[PlanMember]: ...
    @property
    def files(self) -> list[PlanFile]: ...
    @property
    def notes(self) -> list[str]: ...
    @property
    def fingerprint(self) -> str: ...
    def to_dict(self) -> dict[str, Any]: ...
    def to_json(self) -> str: ...

class Plan(_Summary):
    """A change worked out and not yet written. Applied once."""

    @property
    def used(self) -> bool: ...

class Summary(_Summary):
    """What an applied plan changed."""

class Applied:
    summary: Summary

class Changed:
    plan: Plan

class Workspace:
    """A project folder holding a `tuff.lock`."""

    @staticmethod
    def open(path: StrPath) -> Workspace: ...
    @staticmethod
    def init(path: StrPath) -> Workspace: ...
    @property
    def root(self) -> Path: ...
    def plan_install(self, pack: Pack, targets: Sequence[str]) -> Plan: ...
    def plan_update(
        self,
        name: str,
        pack: Pack,
        targets: Optional[Sequence[str]] = None,
        force: bool = False,
    ) -> Optional[Plan]: ...
    def plan_remove(self, name: str, force: bool = False) -> Plan: ...
    def apply(self, plan: Plan, baselines: Optional[Baselines] = None) -> Summary: ...
    def apply_approved(
        self, plan: Plan, approved: str, baselines: Optional[Baselines] = None
    ) -> Union[Applied, Changed]: ...
