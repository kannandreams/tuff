{
  "name": "tuff",
  "displayName": "Tuff",
  "description": "See and manage your agent capabilities: drift, versions, and updates, from the Tuff CLI.",
  "version": "0.2.0",
  "publisher": "kannandreams",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI"
  ],
  "keywords": [
    "tuff",
    "agent",
    "skills",
    "mcp",
    "mcp server",
    "hooks",
    "claude",
    "codex",
    "cursor"
  ],
  "galleryBanner": {
    "color": "#111315",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/kannandreams.tuff",
      "href": "https://marketplace.visualstudio.com/items?itemName=kannandreams.tuff",
      "description": "Marketplace version"
    },
    {
      "url": "https://img.shields.io/github/actions/workflow/status/kannandreams/tuff/tuff-check.yml?branch=main",
      "href": "https://github.com/kannandreams/tuff/actions/workflows/tuff-check.yml",
      "description": "Repository checks"
    }
  ],
  "pricing": "Free",
  "qna": "https://github.com/kannandreams/tuff/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/kannandreams/tuff.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://tuffcli.dev",
  "bugs": {
    "url": "https://github.com/kannandreams/tuff/issues"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Tuff runs the tuff CLI against files on disk, and a virtual workspace has none."
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Tuff runs commands the project itself defines: its MCP servers under Run MCP Doctor, and its hooks. It stays off until the folder is trusted."
    }
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:tuff.lock",
    "onView:tuff.capabilities",
    "onCommand:tuff.browseCatalog",
    "onCommand:tuff.scan",
    "onCommand:tuff.init",
    "onCommand:tuff.addFromGit"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tuff",
          "title": "Tuff",
          "icon": "media/tuff.svg"
        }
      ]
    },
    "views": {
      "tuff": [
        {
          "id": "tuff.capabilities",
          "name": "Capabilities",
          "icon": "media/tuff.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tuff.capabilities",
        "contents": "The Tuff CLI was not found.\n\nThe extension runs the `tuff` binary; it does not bundle one. Install it, or set the path in settings.\n[Installation guide](https://tuffcli.dev/installation/)\n[Open settings](command:tuff.openSettings)",
        "when": "tuff.cliMissing"
      },
      {
        "view": "tuff.capabilities",
        "contents": "No Tuff project here yet.\n\nInitialize one to start tracking capabilities. If this project already has skills in `.claude`, `.cursor`, or `.agents`, a scan will find them and offer to track them where they are — nothing is moved or copied.\n[Initialize Project](command:tuff.init)\n[Scan for Existing Capabilities](command:tuff.scan)\n[Getting started](https://tuffcli.dev/getting-started/)",
        "when": "!tuff.cliMissing && !tuff.hasProject"
      },
      {
        "view": "tuff.capabilities",
        "contents": "No capabilities tracked yet.\n\nScan this project for skills it already has, or install something new.\n[Scan for Existing Capabilities](command:tuff.scan)\n[Browse MCP Catalog](command:tuff.browseCatalog)\n[Add from Git URL](command:tuff.addFromGit)\n[CLI reference](https://tuffcli.dev/cli/)",
        "when": "!tuff.cliMissing && tuff.hasProject && tuff.empty"
      }
    ],
    "commands": [
      {
        "command": "tuff.refresh",
        "title": "Refresh Capabilities",
        "category": "Tuff",
        "icon": "$(refresh)"
      },
      {
        "command": "tuff.checkUpdates",
        "title": "Check for Updates",
        "category": "Tuff",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tuff.runCheck",
        "title": "Validate Capabilities",
        "category": "Tuff",
        "icon": "$(checklist)"
      },
      {
        "command": "tuff.scan",
        "title": "Scan for Existing Capabilities",
        "category": "Tuff",
        "icon": "$(search)"
      },
      {
        "command": "tuff.init",
        "title": "Initialize Project",
        "category": "Tuff"
      },
      {
        "command": "tuff.browseCatalog",
        "title": "Browse MCP Catalog",
        "category": "Tuff",
        "icon": "$(library)"
      },
      {
        "command": "tuff.addFromGit",
        "title": "Add from Git URL",
        "category": "Tuff",
        "icon": "$(repo-clone)"
      },
      {
        "command": "tuff.mcpDoctor",
        "title": "Run MCP Doctor",
        "category": "Tuff"
      },
      {
        "command": "tuff.diff",
        "title": "Show Local Changes",
        "category": "Tuff",
        "icon": "$(diff)"
      },
      {
        "command": "tuff.diffUpstream",
        "title": "Show Upstream Changes",
        "category": "Tuff"
      },
      {
        "command": "tuff.update",
        "title": "Update Capability",
        "category": "Tuff",
        "icon": "$(arrow-up)"
      },
      {
        "command": "tuff.reveal",
        "title": "Reveal in Explorer",
        "category": "Tuff"
      },
      {
        "command": "tuff.showOutput",
        "title": "Show CLI Output",
        "category": "Tuff"
      },
      {
        "command": "tuff.openSettings",
        "title": "Open Settings",
        "category": "Tuff"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tuff.diff",
          "when": "false"
        },
        {
          "command": "tuff.diffUpstream",
          "when": "false"
        },
        {
          "command": "tuff.update",
          "when": "false"
        },
        {
          "command": "tuff.reveal",
          "when": "false"
        },
        {
          "command": "tuff.openSettings",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "tuff.checkUpdates",
          "when": "view == tuff.capabilities",
          "group": "navigation@1"
        },
        {
          "command": "tuff.runCheck",
          "when": "view == tuff.capabilities",
          "group": "navigation@2"
        },
        {
          "command": "tuff.refresh",
          "when": "view == tuff.capabilities",
          "group": "navigation@3"
        },
        {
          "command": "tuff.scan",
          "when": "view == tuff.capabilities",
          "group": "1_run"
        },
        {
          "command": "tuff.browseCatalog",
          "when": "view == tuff.capabilities",
          "group": "1_run"
        },
        {
          "command": "tuff.addFromGit",
          "when": "view == tuff.capabilities",
          "group": "1_run"
        },
        {
          "command": "tuff.mcpDoctor",
          "when": "view == tuff.capabilities",
          "group": "1_run"
        },
        {
          "command": "tuff.showOutput",
          "when": "view == tuff.capabilities",
          "group": "1_run"
        }
      ],
      "view/item/context": [
        {
          "command": "tuff.diff",
          "when": "view == tuff.capabilities && viewItem =~ /^tuff\\.(capability|installation)/",
          "group": "inline@1"
        },
        {
          "command": "tuff.update",
          "when": "view == tuff.capabilities && viewItem =~ /^tuff\\.(capability|installation)/",
          "group": "inline@2"
        },
        {
          "command": "tuff.diffUpstream",
          "when": "view == tuff.capabilities && viewItem =~ /^tuff\\.(capability|installation)/",
          "group": "1_inspect"
        },
        {
          "command": "tuff.reveal",
          "when": "view == tuff.capabilities && viewItem =~ /^tuff\\.(capability|installation)/",
          "group": "1_inspect"
        }
      ]
    },
    "configuration": {
      "title": "Tuff",
      "properties": {
        "tuff.path": {
          "type": "string",
          "default": "tuff",
          "markdownDescription": "Path to the `tuff` executable. The extension shells out to the CLI and does not bundle a binary."
        },
        "tuff.scope": {
          "type": "string",
          "enum": [
            "all",
            "project",
            "global"
          ],
          "default": "all",
          "markdownDescription": "Which scope the view lists, matching `tuff list --scope`."
        },
        "tuff.checkUpdatesOnStartup": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Check for updates when a workspace opens. Off by default: `tuff outdated` reaches the network and clones git sources, so it stays an explicit action."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "tuff.getStarted",
        "title": "Get Started with Tuff",
        "description": "Track the skills, hooks, and MCP servers your coding agents use, from the editor.",
        "featuredFor": [
          "**/tuff.lock",
          "**/.claude/skills/**",
          "**/.cursor/**",
          "**/.agents/**"
        ],
        "steps": [
          {
            "id": "tuff.step.install",
            "title": "Install the Tuff CLI",
            "description": "The extension runs the `tuff` binary already on your machine; it bundles none, so there is one Tuff and one place versions come from.\n[Installation guide](https://tuffcli.dev/installation/)\n[Set the path to tuff](command:tuff.openSettings)",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onContext:tuff.cliReady"
            ]
          },
          {
            "id": "tuff.step.init",
            "title": "Initialize the project",
            "description": "Tracking is recorded in a `tuff.lock` at the root of the project, which `tuff init` creates. Nothing else changes.\n[Initialize Project](command:tuff.init)",
            "media": {
              "markdown": "media/walkthrough/init.md"
            },
            "completionEvents": [
              "onContext:tuff.hasProject"
            ]
          },
          {
            "id": "tuff.step.scan",
            "title": "Track what you already have",
            "description": "Most projects already have skills in `.claude`, `.cursor`, or `.agents` that Tuff knows nothing about. A scan finds them and tracks the ones you pick, where they are.\n[Scan for Existing Capabilities](command:tuff.scan)",
            "media": {
              "markdown": "media/walkthrough/scan.md"
            },
            "completionEvents": [
              "onCommand:tuff.scan"
            ]
          },
          {
            "id": "tuff.step.catalog",
            "title": "Add an MCP server",
            "description": "Pick a server from the built-in catalog and Tuff wires it into every harness the project uses. A key never passes through the editor.\n[Browse MCP Catalog](command:tuff.browseCatalog)",
            "media": {
              "markdown": "media/walkthrough/catalog.md"
            },
            "completionEvents": [
              "onCommand:tuff.browseCatalog"
            ]
          },
          {
            "id": "tuff.step.drift",
            "title": "See drift and updates",
            "description": "The Capabilities view shows what has been edited by hand since it was installed. Updates are checked when you ask, because checking reaches the network.\n[Open the Capabilities view](command:tuff.capabilities.focus)\n[Check for Updates](command:tuff.checkUpdates)",
            "media": {
              "markdown": "media/walkthrough/drift.md"
            },
            "completionEvents": [
              "onCommand:tuff.checkUpdates"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.9.3"
  }
}
