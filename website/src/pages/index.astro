---
import '../styles/custom.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import HeroStory from '../components/HeroStory.astro';


const docs = '/getting-started';
const description = 'Manage project-owned skills, tools, hooks, MCP servers, and policies for coding agents.';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Tuff — capability lifecycle manager for coding agents" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://tuffcli.dev/" />
    <meta property="og:site_name" content="Tuff" />
    <meta property="og:image" content="https://tuffcli.dev/img/tuff-readme-banner.png" />
    <meta property="og:image:width" content="1950" />
    <meta property="og:image:height" content="807" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://tuffcli.dev/img/tuff-readme-banner.png" />
    <link rel="canonical" href="https://tuffcli.dev/" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Tuff — manage coding-agent capabilities in your repo</title>
  </head>
  <body class="tuff-standalone">
    <SiteNav current="/" />

    <main class="tuff-landing tuff-landing--standalone">
      <HeroStory part="hero" />

      <section class="tuff-section" id="how-it-works">
        <div class="tuff-section-head"><div class="tuff-section-label">//how it works</div><h2>The capabilities Tuff manages, and their lifecycle</h2><p>Skills, tools, MCP servers, hooks, and policies are files in your project. Tuff records what is installed, where it came from, and whether it changed.</p></div>
        <div class="tuff-sub-label">//capabilities</div>
        <div class="tuff-cap-grid">
          <a class="tuff-cap-card" href="/primitives/skills"><svg class="tuff-cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 012-2h12v16H6a2 2 0 00-2 2z"/><path d="M4 21V5"/><path d="M8 7h6M8 11h6"/></svg><strong>Skill</strong><span>Instructions and references an agent can load for a project or task.</span></a>
          <a class="tuff-cap-card" href="/primitives/mcp-servers"><svg class="tuff-cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><path d="M7 7h.01M7 17h.01M11 7h6M11 17h6"/></svg><strong>MCP Server</strong><span>External servers wired into every harness from one declaration, with secrets kept as references.</span></a>
          <a class="tuff-cap-card" href="/primitives/tools"><svg class="tuff-cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 6.5a4 4 0 00-5.3 5L4 16.7V20h3.3l5.2-5.2a4 4 0 005-5.3l-2.6 2.6-2.3-.6-.6-2.3z"/></svg><strong>Tool</strong><span>Callable scripts and functions with a typed contract, including servers you ship yourself.</span></a>
          <a class="tuff-cap-card" href="/primitives/hooks"><svg class="tuff-cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L4.5 13.5H11L10 22l8.5-11.5H12z"/></svg><strong>Hook</strong><span>Automation attached to supported lifecycle events in a harness.</span></a>
          <div class="tuff-cap-card tuff-cap-card--next"><svg class="tuff-cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="7" width="16" height="12" rx="2"/><path d="M12 3v4"/><circle cx="9" cy="13" r="1"/><circle cx="15" cy="13" r="1"/><path d="M1.5 12v3M22.5 12v3"/></svg><strong>Agent <i class="tuff-cap-tag">in formation</i></strong><span>Package capabilities and runtime configuration into a versioned agent definition.</span></div>
          <a class="tuff-cap-card tuff-cap-card--wide" href="/primitives/policies"><svg class="tuff-cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 7.7-8 9-4.6-1.3-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg><strong>Policy Control</strong><span><em>Governs every capability.</em> Set which capabilities can be installed, from which sources, and for which harnesses, enforced consistently across every agent your team runs.</span></a>
        </div>
        <div class="tuff-sub-label tuff-sub-label--gap">//lifecycle</div>
        <div class="tuff-steps-grid tuff-steps-grid--4">
          <div class="tuff-step-item"><svg class="tuff-step-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 5l11 6v10l-11 6-11-6V11z"/><path d="M5 11l11 6 11-6"/><path d="M16 17v10"/></svg><b>01</b><strong class="tuff-step-title">Create or add</strong><p>Start a new skill, tool, hook, MCP server, or policy, or bring existing agent files under management without rewriting their content.</p></div>
          <div class="tuff-step-item"><svg class="tuff-step-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18h5l3-9 5 16 3-11 2 4h6"/></svg><b>02</b><strong class="tuff-step-title">Track</strong><p>Record source, version, scope, harness, emitted path, and the clean install baseline in project state.</p></div>
          <div class="tuff-step-item"><svg class="tuff-step-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6v8a4 4 0 004 4h8"/><path d="M16 14l4 4-4 4"/></svg><b>03</b><strong class="tuff-step-title">Diff</strong><p>Compare the current files against the baseline so intentional edits are visible and accidental drift is not silent.</p></div>
          <div class="tuff-step-item"><svg class="tuff-step-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4l10 4v8c0 7-4.5 10.5-10 12-5.5-1.5-10-5-10-12V8z"/><path d="M16 12v8"/><path d="M12 16h8"/></svg><b>04</b><strong class="tuff-step-title">Update or check</strong><p>Accept deliberate local changes, merge upstream updates where possible, and fail CI when tracked capabilities are not in the expected state.</p></div>
        </div>
        <div class="tuff-stats tuff-stats--after-steps">
          <div class="tuff-stat"><small>//state</small><strong>Everything lives in your repo</strong><p>Tuff works like a package manager for agent capabilities, with a lockfile in your repo. Commit it and the whole team gets the same setup. No hosted service.</p></div>
          <div class="tuff-stat"><small>//sources</small><strong>Install from sources you trust</strong><p>A local directory, a Git repository, an OCI registry, or the built-in MCP catalog, with the origin recorded either way.</p></div>
          <div class="tuff-stat"><small>//scopes</small><strong>Project scope wins</strong><p>Capabilities can be project-scoped or global. When both define the same one, the version checked into the repo takes precedence.</p></div>
        </div>
      </section>

      <HeroStory part="dashboard" />

      <section class="tuff-section" id="packs">
        <div class="tuff-section-head"><div class="tuff-section-label">//tuff packs</div><h2 id="packs-title">Bundle once. Ship as a verified release.</h2><p id="packs-description">Bundle the skills, tools, hooks, and MCP servers behind an integration into one deterministic artifact. Publish it through OCI, pin it by digest, and deploy the same reviewed bundle to every agent runtime.</p></div>
        <figure class="tuff-pack-showcase" aria-labelledby="packs-title" aria-describedby="packs-description">
          <div class="tuff-pack-stage tuff-pack-stage--capabilities">
            <div class="tuff-pack-stage-label">CRM capabilities</div>
            <ul class="tuff-pack-capabilities">
              <li><strong>CRM operating</strong><span>skill</span></li>
              <li><strong>CRM connector</strong><span>MCP tool</span></li>
              <li><strong>PII guard</strong><span>hook</span></li>
              <li><strong>Lead scoring</strong><span>tool</span></li>
            </ul>
          </div>
          <div class="tuff-pack-flow" aria-hidden="true"><span>build</span><i></i></div>
          <div class="tuff-pack-stage tuff-pack-stage--artifact">
            <div class="tuff-pack-stage-label">Tuff pack</div>
            <strong class="tuff-pack-reference">yourorg/crm-integration:1.2.0</strong>
            <code>crm-integration.tuffpack</code>
            <div class="tuff-pack-digest"><span>sha256</span>84a1c7e9…2f40</div>
            <div class="tuff-pack-badges"><span>4 capabilities</span><span>2 targets</span><span class="tuff-pack-verified">verified ✓</span></div>
          </div>
          <div class="tuff-pack-flow" aria-hidden="true"><span>publish</span><i></i></div>
          <div class="tuff-pack-stage tuff-pack-stage--registry">
            <div class="tuff-pack-stage-label">OCI registry</div>
            <div class="tuff-pack-registry-mark" aria-hidden="true"><i></i><i></i><i></i></div>
            <code>yourorg/crm-integration:1.2.0</code>
            <strong>digest pinned</strong>
            <div class="tuff-pack-trust"><span>signed</span><span>attested</span><span>policy approved</span></div>
          </div>
          <div class="tuff-pack-flow" aria-hidden="true"><span>deploy</span><i></i></div>
          <div class="tuff-pack-stage tuff-pack-stage--runtime">
            <div class="tuff-pack-stage-label">Agent runtime</div>
            <strong>Runtime filesystem</strong>
            <p>Harness-native files, extracted from the exact reviewed artifact.</p>
            <ul class="tuff-pack-files"><li>.agents/skills/</li><li>.mcp.json</li><li>.agents/hooks/</li></ul>
          </div>
        </figure>
        <a class="tuff-button tuff-button--primary tuff-pack-cta" href="/concepts/packs">Explore Tuff Packs</a>
      </section>

      <section class="tuff-section">
        <div class="tuff-section-head"><div class="tuff-section-label">//harnesses</div><h2>Write once, emit per harness</h2><p>Write a capability once in <code>tuff.toml</code>. Tuff turns it into the file each agent reads, in that agent's own format.</p></div>
        <!-- The outputs below are what `tuff add` writes today (tuff 0.10.0). Codex is left out of the hook
             example until internal #40 moves its hooks to the file Codex reads. -->
        <div class="tuff-adapter" data-adapter-tabs>
          <div class="tuff-install-tabs tuff-adapter-tabs" role="tablist" aria-label="Capability example">
            <button class="is-active" type="button" role="tab" id="tuff-adapter-tab-hook" aria-controls="tuff-adapter-hook" aria-selected="true">hook</button>
            <button type="button" role="tab" id="tuff-adapter-tab-policy" aria-controls="tuff-adapter-policy" aria-selected="false" tabindex="-1">policy</button>
          </div>
          <div class="tuff-adapter-diagram" role="tabpanel" id="tuff-adapter-hook" aria-labelledby="tuff-adapter-tab-hook">
            <div class="tuff-manifest">
              <div class="tuff-manifest-file" style="--i: 0">tuff.toml</div>
              <div style="--i: 1"><span>id =</span> "lint-before-tools"</div>
              <div style="--i: 2"><span>type =</span> "hook"</div>
              <div style="--i: 3"><span>[hook]</span></div>
              <div style="--i: 4"><span>event =</span> "pre_tool_use"</div>
              <div style="--i: 5"><span>command =</span> "npm run lint"</div>
            </div>
            <div class="tuff-compile"><i></i><span>tuff add</span></div>
            <div class="tuff-harness-list">
              <div style="--i: 3"><strong>claude</strong><small>.claude/settings.json</small><code>"PreToolUse" → sh .claude/hooks/lint-before-tools/run.sh</code></div>
              <div style="--i: 4"><strong>cursor</strong><small>.cursor/hooks.json</small><code>"preToolUse" → sh .cursor/hooks/lint-before-tools/run.sh</code></div>
            </div>
          </div>
          <div class="tuff-adapter-diagram" role="tabpanel" id="tuff-adapter-policy" aria-labelledby="tuff-adapter-tab-policy" hidden>
            <div class="tuff-manifest">
              <div class="tuff-manifest-file" style="--i: 0">tuff.toml</div>
              <div style="--i: 1"><span>id =</span> "no-force-push"</div>
              <div style="--i: 2"><span>type =</span> "policy"</div>
              <div style="--i: 3"><span>[[policy.rules]]</span></div>
              <div style="--i: 4"><span>effect =</span> "deny"</div>
              <div style="--i: 5"><span>command =</span> ["git", "push", <em class="tuff-nowrap">"--force"]</em></div>
            </div>
            <div class="tuff-compile"><i></i><span>tuff add</span></div>
            <div class="tuff-harness-list">
              <div style="--i: 3"><strong>claude</strong><small>.claude/settings.json</small><code>"permissions.deny" → "Bash(git push <em class="tuff-nowrap">--force *)"</em></code></div>
              <div class="is-muted" style="--i: 4"><strong>codex, cursor</strong><small>not enforced yet</small><code>install refused, so no rule is assumed</code></div>
            </div>
          </div>
        </div>
      </section>

      <section class="tuff-section tuff-section--last">
        <div class="tuff-section-head"><div class="tuff-section-label">//day two</div><h2>Operational Features</h2><p>The parts that matter after day one.</p></div>
        <div class="tuff-why-grid">
          <div><b>01</b><strong>CI Integration</strong><p>Run the check in CI and fail the build on drift, not after it's already shipped.</p><a class="tuff-button tuff-button--primary tuff-feature-button" href="/cli/ci/#ci-with-github-actions">GitHub Actions</a></div>
          <div><b>02</b><strong>Tuff Skills</strong><p>Tuff ships as a skill itself. The agent learns the CLI and hook spec on install, so it writes manifests and runs commands for you instead of you doing it by hand.</p><a class="tuff-button tuff-button--primary tuff-feature-button" href="/getting-started">tuff init</a></div>
          <div><b>03</b><strong>Audit Reports</strong><p>Generate a full report of every installed capability, its source, and its policy status, right from the CLI, no hosted service required.</p><a class="tuff-button tuff-button--primary tuff-feature-button" href="/cli/inspect/#tuff-generate">tuff generate report</a></div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>


<script>
  // The harness example: switch between the hook and policy panels. While the
  // section is on screen the panels alternate, until the reader picks one,
  // hovers or focuses the example, or prefers reduced motion.
  document.querySelectorAll<HTMLElement>('[data-adapter-tabs]').forEach((group) => {
    const tabs = [...group.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    let chosen = false;
    let paused = false;
    let visible = false;

    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const item of tabs) {
        const on = item === tab;
        item.classList.toggle('is-active', on);
        item.setAttribute('aria-selected', String(on));
        item.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(item.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        chosen = true;
        select(tab);
      });
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        chosen = true;
        const step = event.key === 'ArrowRight' ? 1 : tabs.length - 1;
        select(tabs[(index + step) % tabs.length], true);
      });
    });

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }, { threshold: 0.4 }).observe(group);
    group.addEventListener('mouseenter', () => { paused = true; });
    group.addEventListener('mouseleave', () => { paused = false; });
    group.addEventListener('focusin', () => { paused = true; });
    group.addEventListener('focusout', () => { paused = false; });

    setInterval(() => {
      if (chosen || paused || !visible || document.hidden) return;
      const current = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      select(tabs[(current + 1) % tabs.length]);
    }, 6000);
  });
</script>
