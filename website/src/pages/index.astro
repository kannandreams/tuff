---
import '../styles/custom.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import HeroVariants from '../components/HeroVariants.astro';
import HeroStory from '../components/HeroStory.astro';

// Hero variations are a local preview only; a production build shows the current hero.
const heroPreview = import.meta.env.DEV;

const docs = '/getting-started';
const description = 'Manage project-owned skills, tools, hooks, MCP servers, and policies for coding agents.';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Tuff — capability lifecycle manager for coding agents" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://tuffcli.dev/" />
    <meta property="og:site_name" content="Tuff" />
    <meta property="og:image" content="https://tuffcli.dev/img/tuff-readme-banner.png" />
    <meta property="og:image:width" content="1950" />
    <meta property="og:image:height" content="807" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://tuffcli.dev/img/tuff-readme-banner.png" />
    <link rel="canonical" href="https://tuffcli.dev/" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Tuff — manage coding-agent capabilities in your repo</title>
  </head>
  <body class="tuff-standalone">
    <SiteNav current="/" />

    <main class="tuff-landing tuff-landing--standalone">
      <section class="tuff-hero" data-hero-variant="current">
        <div class="tuff-hero-main">
          <h1 class="tuff-wordmark">t<span>u</span>ff</h1>
          <p class="tuff-tagline">Capability lifecycle manager for coding agents.</p>
          <p class="tuff-hero-copy">
            A CLI for teams that keep agent capabilities in the repo: install one, record where it came from,
            catch drift before it causes a bad run, and emit exactly what each harness expects.
          </p>
          <ul class="tuff-badges" aria-label="Project facts">
            <li class="tuff-badge tuff-badge--rust">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l1.6 2.1 2.5-.9.4 2.6 2.6.4-.9 2.5 2.1 1.6-2.1 1.6.9 2.5-2.6.4-.4 2.6-2.5-.9L12 21.5l-1.6-2.1-2.5.9-.4-2.6-2.6-.4.9-2.5L3.7 12l2.1-1.6-.9-2.5 2.6-.4.4-2.6 2.5.9z"/><circle cx="12" cy="12" r="3.2"/></svg>
              Built in Rust <span aria-hidden="true">·</span> single binary
            </li>
          </ul>
          <div class="tuff-install" data-install-tabs>
            <div class="tuff-install-tabs" role="tablist" aria-label="Install Tuff">
              <button class="is-active" type="button" role="tab" aria-selected="true" data-install-tab="uv">uv</button>
              <button type="button" role="tab" aria-selected="false" data-install-tab="pip">pip</button>
              <button type="button" role="tab" aria-selected="false" data-install-tab="brew">brew</button>
              <button type="button" role="tab" aria-selected="false" data-install-tab="cargo">cargo</button>
              <button type="button" role="tab" aria-selected="false" data-install-tab="install">install</button>
            </div>
            <div class="tuff-install-command"><span>$</span><code data-install-command>uv tool install tuffcli</code><button type="button" aria-label="Copy install command" data-copy-command>copy</button></div>
          </div>
          <div class="tuff-hero-actions">
            <a class="tuff-button tuff-button--primary" href={docs}>Read the docs <span aria-hidden="true">→</span></a>
            <a class="tuff-hero-link" href="/intro/#why-tuff-exists">Why Tuff exists</a>
          </div>
        </div>

        <div class="tuff-hero-demo">
          <div class="tuff-terminal" aria-label="Example Tuff CLI session">
            <div class="tuff-term-bar"><i></i><i></i><i></i><span>~/tuff</span></div>
            <div class="tuff-term-body">
              <div style="--i: 0"><b>$</b> tuff init</div>
              <div style="--i: 1" class="tuff-output">created tuff.lock</div>
              <div style="--i: 2" class="tuff-output">registered <mark>open-agents</mark> as the default harness</div>
              <div style="--i: 3" class="tuff-output tuff-output--ok">installed tuff-cli-guide</div>
              <div style="--i: 4" class="tuff-spacer"></div>
              <div style="--i: 5"><b>$</b> tuff create skill project-review</div>
              <div style="--i: 6" class="tuff-output">tracked .agents/skills/project-review/SKILL.md</div>
              <div style="--i: 7"><b>$</b> tuff diff project-review</div>
              <div style="--i: 8" class="tuff-output">modified since baseline</div>
              <div style="--i: 9"><b>$</b> tuff check</div>
              <div style="--i: 10" class="tuff-output tuff-output--ok">project-review  skill  open-agents  ok</div>
            </div>
          </div>
        </div>

        <div class="tuff-harness-strip">
          <span class="tuff-harness-strip-label">works with</span>
          <ul aria-label="Supported agent harnesses">
            <li class="tuff-chip tuff-chip--adapter" title="Dedicated adapter">Claude Code</li>
            <li class="tuff-chip tuff-chip--adapter" title="Dedicated adapter">Codex</li>
            <li class="tuff-chip tuff-chip--adapter" title="Dedicated adapter">Cursor</li>
            <!-- Agents below read skills from .agents/skills/, checked against each tool's docs on 2026-09-13. -->
            <li class="tuff-chip" title="Skills via .agents/skills">GitHub Copilot</li>
            <li class="tuff-chip" title="Skills via .agents/skills">Gemini CLI</li>
            <li class="tuff-chip" title="Skills via .agents/skills">OpenCode</li>
            <li class="tuff-chip" title="Skills via .agents/skills">Windsurf</li>
            <li class="tuff-chip" title="Skills via .agents/skills">Amp</li>
            <li class="tuff-chip" title="Skills via .agents/skills">Goose</li>
            <li class="tuff-chip" title="Skills via .agents/skills">Junie</li>
          </ul>
          <span class="tuff-harness-strip-note"><i aria-hidden="true"></i> dedicated adapter · others via .agents/skills</span>
        </div>
      </section>

      {heroPreview && <HeroVariants />}
      {heroPreview && <HeroStory />}

      <section class="tuff-section tuff-section--stats">
        <div class="tuff-stats">
          <div class="tuff-stat"><small>//state</small><strong>Everything lives in your repo</strong><p><code>tuff.lock</code> records each capability's source, target, and hash. Commit it and the whole team gets the same setup. No hosted service.</p></div>
          <div class="tuff-stat"><small>//sources</small><strong>Install from sources you trust</strong><p>A local directory, a Git repository, an OCI registry, or the built-in MCP catalog, with the origin recorded either way.</p></div>
          <div class="tuff-stat"><small>//scopes</small><strong>Project scope wins</strong><p>Capabilities can be project-scoped or global. When both define the same one, the version checked into the repo takes precedence.</p></div>
        </div>
      </section>

      <section class="tuff-section">
        <div class="tuff-section-head"><div class="tuff-section-label">//how it works</div><h2>The lifecycle Tuff manages</h2><p>Agent capabilities are useful only if a team can tell what is installed, where it came from, and whether it changed.</p></div>
        <div class="tuff-steps-grid tuff-steps-grid--4">
          <div class="tuff-step-item"><svg class="tuff-step-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 5l11 6v10l-11 6-11-6V11z"/><path d="M5 11l11 6 11-6"/><path d="M16 17v10"/></svg><b>01</b><strong class="tuff-step-title">Create or add</strong><p>Start a new skill, tool, hook, MCP server, or policy, or bring existing agent files under management without rewriting their content.</p></div>
          <div class="tuff-step-item"><svg class="tuff-step-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18h5l3-9 5 16 3-11 2 4h6"/></svg><b>02</b><strong class="tuff-step-title">Track</strong><p>Record source, version, scope, harness, emitted path, and the clean install baseline in project state.</p></div>
          <div class="tuff-step-item"><svg class="tuff-step-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6v8a4 4 0 004 4h8"/><path d="M16 14l4 4-4 4"/></svg><b>03</b><strong class="tuff-step-title">Diff</strong><p>Compare the current files against the baseline so intentional edits are visible and accidental drift is not silent.</p></div>
          <div class="tuff-step-item"><svg class="tuff-step-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4l10 4v8c0 7-4.5 10.5-10 12-5.5-1.5-10-5-10-12V8z"/><path d="M16 12v8"/><path d="M12 16h8"/></svg><b>04</b><strong class="tuff-step-title">Update or check</strong><p>Accept deliberate local changes, merge upstream updates where possible, and fail CI when tracked capabilities are not in the expected state.</p></div>
        </div>
      </section>

      <section class="tuff-section">
        <div class="tuff-section-head"><div class="tuff-section-label">//capabilities</div><h2>The things agents load should be first-class project assets</h2><p>Tuff treats these as managed files, not magic settings hidden inside one developer's local harness.</p></div>
        <div class="tuff-cap-grid">
          <a class="tuff-cap-card" href="/primitives/skills"><strong>Skill</strong><span>Instructions and references an agent can load for a project or task.</span></a>
          <a class="tuff-cap-card" href="/primitives/mcp-servers"><strong>MCP Server</strong><span>External servers wired into every harness from one declaration, with secrets kept as references.</span></a>
          <a class="tuff-cap-card" href="/primitives/tools"><strong>Tool</strong><span>Callable scripts and functions with a typed contract, including servers you ship yourself.</span></a>
          <a class="tuff-cap-card" href="/primitives/hooks"><strong>Hook</strong><span>Automation attached to supported lifecycle events in a harness.</span></a>
          <a class="tuff-cap-card tuff-cap-card--next" href="/primitives/format"><strong>Your next kind</strong><span>Tuff is built to take on new capability kinds. Each one gets the same lifecycle: install, track, diff, check, and pack.</span></a>
          <a class="tuff-cap-card tuff-cap-card--wide" href="/primitives/policies"><strong>Policy Control</strong><span><em>Governs the other four.</em> Set which capabilities can be installed, from which sources, and for which harnesses, enforced consistently across every agent your team runs.</span></a>
        </div>
      </section>

      <section class="tuff-section" id="packs">
        <div class="tuff-section-head"><div class="tuff-section-label">//tuff packs</div><h2 id="packs-title">Bundle once. Ship as a verified release.</h2><p id="packs-description">Bundle the skills, tools, hooks, and MCP servers behind an integration into one deterministic artifact. Publish it through OCI, pin it by digest, and deploy the same reviewed bundle to every agent runtime.</p></div>
        <figure class="tuff-pack-showcase" aria-labelledby="packs-title" aria-describedby="packs-description">
          <div class="tuff-pack-stage tuff-pack-stage--capabilities">
            <div class="tuff-pack-stage-label">CRM capabilities</div>
            <ul class="tuff-pack-capabilities">
              <li><strong>CRM operating</strong><span>skill</span></li>
              <li><strong>CRM connector</strong><span>MCP tool</span></li>
              <li><strong>PII guard</strong><span>hook</span></li>
              <li><strong>Lead scoring</strong><span>tool</span></li>
            </ul>
          </div>
          <div class="tuff-pack-flow" aria-hidden="true"><span>build</span><i></i></div>
          <div class="tuff-pack-stage tuff-pack-stage--artifact">
            <div class="tuff-pack-stage-label">Tuff pack</div>
            <strong class="tuff-pack-reference">yourorg/crm-integration:1.2.0</strong>
            <code>crm-integration.tuffpack</code>
            <div class="tuff-pack-digest"><span>sha256</span>84a1c7e9…2f40</div>
            <div class="tuff-pack-badges"><span>4 capabilities</span><span>2 targets</span><span class="tuff-pack-verified">verified ✓</span></div>
          </div>
          <div class="tuff-pack-flow" aria-hidden="true"><span>publish</span><i></i></div>
          <div class="tuff-pack-stage tuff-pack-stage--registry">
            <div class="tuff-pack-stage-label">OCI registry</div>
            <div class="tuff-pack-registry-mark" aria-hidden="true"><i></i><i></i><i></i></div>
            <code>yourorg/crm-integration:1.2.0</code>
            <strong>digest pinned</strong>
            <div class="tuff-pack-trust"><span>signed</span><span>attested</span><span>policy approved</span></div>
          </div>
          <div class="tuff-pack-flow" aria-hidden="true"><span>deploy</span><i></i></div>
          <div class="tuff-pack-stage tuff-pack-stage--runtime">
            <div class="tuff-pack-stage-label">Agent runtime</div>
            <strong>Runtime filesystem</strong>
            <p>Harness-native files, extracted from the exact reviewed artifact.</p>
            <ul class="tuff-pack-files"><li>.agents/skills/</li><li>.mcp.json</li><li>.agents/hooks/</li></ul>
          </div>
        </figure>
        <a class="tuff-button tuff-button--primary tuff-pack-cta" href="/concepts/packs">Explore Tuff Packs</a>
      </section>

      <section class="tuff-section">
        <div class="tuff-section-head"><div class="tuff-section-label">//harnesses</div><h2>Write once, emit per harness</h2><p>Write a capability once in <code>tuff.toml</code>. Tuff turns it into the file each agent reads, in that agent's own format.</p></div>
        <!-- The outputs below are what `tuff add` writes today (tuff 0.10.0). Codex is left out of the hook
             example until internal #40 moves its hooks to the file Codex reads. -->
        <div class="tuff-adapter" data-adapter-tabs>
          <div class="tuff-install-tabs tuff-adapter-tabs" role="tablist" aria-label="Capability example">
            <button class="is-active" type="button" role="tab" id="tuff-adapter-tab-hook" aria-controls="tuff-adapter-hook" aria-selected="true">hook</button>
            <button type="button" role="tab" id="tuff-adapter-tab-policy" aria-controls="tuff-adapter-policy" aria-selected="false" tabindex="-1">policy</button>
          </div>
          <div class="tuff-adapter-diagram" role="tabpanel" id="tuff-adapter-hook" aria-labelledby="tuff-adapter-tab-hook">
            <div class="tuff-manifest">
              <div class="tuff-manifest-file" style="--i: 0">tuff.toml</div>
              <div style="--i: 1"><span>id =</span> "lint-before-tools"</div>
              <div style="--i: 2"><span>type =</span> "hook"</div>
              <div style="--i: 3"><span>[hook]</span></div>
              <div style="--i: 4"><span>event =</span> "pre_tool_use"</div>
              <div style="--i: 5"><span>command =</span> "npm run lint"</div>
            </div>
            <div class="tuff-compile"><i></i><span>tuff add</span></div>
            <div class="tuff-harness-list">
              <div style="--i: 3"><strong>claude</strong><small>.claude/settings.json</small><code>"PreToolUse" → sh .claude/hooks/lint-before-tools/run.sh</code></div>
              <div style="--i: 4"><strong>cursor</strong><small>.cursor/hooks.json</small><code>"preToolUse" → sh .cursor/hooks/lint-before-tools/run.sh</code></div>
            </div>
          </div>
          <div class="tuff-adapter-diagram" role="tabpanel" id="tuff-adapter-policy" aria-labelledby="tuff-adapter-tab-policy" hidden>
            <div class="tuff-manifest">
              <div class="tuff-manifest-file" style="--i: 0">tuff.toml</div>
              <div style="--i: 1"><span>id =</span> "no-force-push"</div>
              <div style="--i: 2"><span>type =</span> "policy"</div>
              <div style="--i: 3"><span>[[policy.rules]]</span></div>
              <div style="--i: 4"><span>effect =</span> "deny"</div>
              <div style="--i: 5"><span>command =</span> ["git", "push", <em class="tuff-nowrap">"--force"]</em></div>
            </div>
            <div class="tuff-compile"><i></i><span>tuff add</span></div>
            <div class="tuff-harness-list">
              <div style="--i: 3"><strong>claude</strong><small>.claude/settings.json</small><code>"permissions.deny" → "Bash(git push <em class="tuff-nowrap">--force *)"</em></code></div>
              <div class="is-muted" style="--i: 4"><strong>codex, cursor</strong><small>not enforced yet</small><code>install refused, so no rule is assumed</code></div>
            </div>
          </div>
        </div>
      </section>

      <section class="tuff-section tuff-section--last">
        <div class="tuff-section-head"><div class="tuff-section-label">//day two</div><h2>Operational Features</h2><p>The parts that matter after day one.</p></div>
        <div class="tuff-why-grid">
          <div><b>01</b><strong>CI Integration</strong><p>Run the check in CI and fail the build on drift, not after it's already shipped.</p><a class="tuff-button tuff-button--primary tuff-feature-button" href="/cli/ci/#ci-with-github-actions">GitHub Actions</a></div>
          <div><b>02</b><strong>Tuff Skills</strong><p>Tuff ships as a skill itself. The agent learns the CLI and hook spec on install, so it writes manifests and runs commands for you instead of you doing it by hand.</p><a class="tuff-button tuff-button--primary tuff-feature-button" href="/getting-started">tuff init</a></div>
          <div><b>03</b><strong>Audit Reports</strong><p>Generate a full report of every installed capability, its source, and its policy status, right from the CLI, no hosted service required.</p><a class="tuff-button tuff-button--primary tuff-feature-button" href="/cli/inspect/#tuff-generate">tuff generate report</a></div>
        </div>
      </section>
    </main>
    <SiteFooter />
    {heroPreview && (
      <div class="hv-picker">
        <label for="hv-select">Hero preview</label>
        <select id="hv-select">
          <option value="current">Current</option>
          <option value="1">1 · From scattered to governed</option>
          <option value="2">2 · Build an agent's toolkit once</option>
          <option value="3">3 · The lifecycle, told as steps</option>
          <option value="4">4 · Support agent (1 + 3, with dashboard)</option>
        </select>
        <label for="hv-headline">Headline</label>
        <select id="hv-headline">
          <option value="e">e · One rolling line</option>
          <option value="a">a · Four lines: Bring together / Use / Ship / Govern</option>
          <option value="b">b · One set of capabilities / Every …</option>
          <option value="c">c · Managed like code · write code ship govern</option>
          <option value="d">d · Build it once / Run / Pack / See</option>
        </select>
      </div>
    )}
  </body>
</html>

<style is:global>
  [data-hero-variant][hidden] { display: none !important; }
  .hv-picker { position: fixed; right: 1rem; bottom: 1rem; z-index: 50; display: flex; align-items: center; gap: .55rem; padding: .55rem .7rem; border: 1px solid #343934; border-radius: .4rem; background: #1b1e1b; box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, .25); color: #eeeae2; font-family: 'JetBrains Mono', monospace; font-size: .72rem; }
  .hv-picker select { padding: .3rem .4rem; border: 1px solid #4c544c; border-radius: .25rem; color: #eeeae2; background: #242824; font: inherit; }
</style>

<script>
  // Local hero preview: show one variant, remembered in the URL (?hero=2).
  const heroSelect = document.querySelector<HTMLSelectElement>('#hv-select');
  if (heroSelect) {
    const show = (value: string) => {
      document.querySelectorAll<HTMLElement>('[data-hero-variant]').forEach((section) => {
        section.hidden = section.dataset.heroVariant !== value;
      });
      heroSelect.value = value;
      const url = new URL(location.href);
      url.searchParams.set('hero', value);
      history.replaceState(null, '', url);
    };
    show(new URL(location.href).searchParams.get('hero') ?? 'current');
    heroSelect.addEventListener('change', () => show(heroSelect.value));
    const headlineSelect = document.querySelector<HTMLSelectElement>('#hv-headline');
    if (headlineSelect) {
      headlineSelect.value = new URL(location.href).searchParams.get('headline') ?? 'e';
      headlineSelect.addEventListener('change', () => {
        const url = new URL(location.href);
        url.searchParams.set('headline', headlineSelect.value);
        location.href = url.toString();
      });
    }
  }

  const commands = {
    uv: 'uv tool install tuffcli',
    pip: 'pip install tuffcli',
    brew: 'brew tap kannandreams/homebrew-tuff && brew install tuff',
    cargo: 'cargo install tuffcli',
    install: 'curl -fsSL https://tuff.dev/install.sh | sh',
  } as const;

  type InstallMethod = keyof typeof commands;

  document.querySelectorAll<HTMLElement>('[data-install-tabs]').forEach((group) => {
    const command = group.querySelector<HTMLElement>('[data-install-command]');
    const copy = group.querySelector<HTMLButtonElement>('[data-copy-command]');
    if (!command || !copy) return;

    group.querySelectorAll<HTMLElement>('[data-install-tab]').forEach((tab) => {
      tab.addEventListener('click', () => {
        group.querySelectorAll('[data-install-tab]').forEach((item) => {
          item.classList.toggle('is-active', item === tab);
          item.setAttribute('aria-selected', String(item === tab));
        });
        const method = tab.dataset.installTab as InstallMethod | undefined;
        if (method && method in commands) command.textContent = commands[method];
      });
    });
    copy.addEventListener('click', async () => {
      await navigator.clipboard.writeText(command.textContent ?? '');
      copy.textContent = 'copied';
      setTimeout(() => { copy.textContent = 'copy'; }, 1200);
    });
  });

  // The harness example: switch between the hook and policy panels. While the
  // section is on screen the panels alternate, until the reader picks one,
  // hovers or focuses the example, or prefers reduced motion.
  document.querySelectorAll<HTMLElement>('[data-adapter-tabs]').forEach((group) => {
    const tabs = [...group.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    let chosen = false;
    let paused = false;
    let visible = false;

    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const item of tabs) {
        const on = item === tab;
        item.classList.toggle('is-active', on);
        item.setAttribute('aria-selected', String(on));
        item.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(item.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        chosen = true;
        select(tab);
      });
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        chosen = true;
        const step = event.key === 'ArrowRight' ? 1 : tabs.length - 1;
        select(tabs[(index + step) % tabs.length], true);
      });
    });

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }, { threshold: 0.4 }).observe(group);
    group.addEventListener('mouseenter', () => { paused = true; });
    group.addEventListener('mouseleave', () => { paused = false; });
    group.addEventListener('focusin', () => { paused = true; });
    group.addEventListener('focusout', () => { paused = false; });

    setInterval(() => {
      if (chosen || paused || !visible || document.hidden) return;
      const current = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      select(tabs[(current + 1) % tabs.length]);
    }, 6000);
  });
</script>
