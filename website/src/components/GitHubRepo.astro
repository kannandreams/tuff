---
// The GitHub repository card: the GitHub mark, the repository name, and
// below it the latest release, stars, and forks.
//
// It renders complete from build-time values (see src/lib/repo.ts), then a
// script refreshes them from the GitHub API, cached for an hour per browser
// session, so a page built before a release still shows that release.
import { REPO, REPO_URL, formatCount, repoStats } from '../lib/repo';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { version, stars, forks } = await repoStats();
---

<a class:list={['tuff-repo', className]} href={REPO_URL} rel="me" aria-label={`${REPO} on GitHub`} data-tuff-repo>
  <svg class="tuff-repo-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.6-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z"/></svg>
  <span class="tuff-repo-text" aria-hidden="true">
    <span class="tuff-repo-name">{REPO}</span>
    <span class="tuff-repo-facts">
      <span class="tuff-repo-fact" data-fact="version" hidden={!version}>
        <svg viewBox="0 0 16 16"><path d="M1 7.775V2.75C1 1.784 1.784 1 2.75 1h5.025c.464 0 .91.184 1.238.513l6.25 6.25a1.75 1.75 0 0 1 0 2.474l-5.026 5.026a1.75 1.75 0 0 1-2.474 0l-6.25-6.25A1.752 1.752 0 0 1 1 7.775Zm1.5 0c0 .066.026.13.073.177l6.25 6.25a.25.25 0 0 0 .354 0l5.025-5.025a.25.25 0 0 0 0-.354l-6.25-6.25a.25.25 0 0 0-.177-.073H2.75a.25.25 0 0 0-.25.25ZM6 5a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg>
        <span data-value>{version}</span>
      </span>
      <span class="tuff-repo-fact" data-fact="stars" hidden={stars === null}>
        <svg viewBox="0 0 16 16"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Zm0 2.445L6.615 5.5a.75.75 0 0 1-.564.41l-3.097.45 2.24 2.184a.75.75 0 0 1 .216.664l-.528 3.084 2.769-1.456a.75.75 0 0 1 .698 0l2.77 1.456-.53-3.084a.75.75 0 0 1 .216-.664l2.24-2.183-3.096-.45a.75.75 0 0 1-.564-.41L8 2.694Z"/></svg>
        <span data-value>{stars !== null && formatCount(stars)}</span>
      </span>
      <span class="tuff-repo-fact" data-fact="forks" hidden={forks === null}>
        <svg viewBox="0 0 16 16"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/></svg>
        <span data-value>{forks !== null && formatCount(forks)}</span>
      </span>
    </span>
  </span>
</a>

<script>
  const REPO = 'kannandreams/tuff';
  const KEY = 'tuff-repo-stats';
  const TTL = 60 * 60 * 1000;

  type Stats = { version: string | null; stars: string | null; forks: string | null };

  const formatCount = (n: number) =>
    n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n);

  function apply(stats: Stats) {
    for (const card of document.querySelectorAll('[data-tuff-repo]')) {
      for (const [fact, value] of Object.entries(stats)) {
        const el = card.querySelector<HTMLElement>(`[data-fact="${fact}"]`);
        const slot = el?.querySelector('[data-value]');
        if (!el || !slot || value === null) continue;
        slot.textContent = value;
        el.hidden = false;
      }
    }
  }

  function cached(): Stats | null {
    try {
      const entry = JSON.parse(sessionStorage.getItem(KEY) ?? 'null');
      return entry && Date.now() - entry.at < TTL ? entry.stats : null;
    } catch {
      return null;
    }
  }

  async function refresh() {
    const hit = cached();
    if (hit) return apply(hit);
    try {
      const get = (path: string) =>
        fetch(`https://api.github.com/repos/${REPO}${path}`).then((r) => (r.ok ? r.json() : null));
      const [repo, releases] = await Promise.all([get(''), get('/releases?per_page=20')]);
      // Only a CLI release counts: a plain vX.Y.Z tag, not a draft or prerelease.
      const release = Array.isArray(releases)
        ? releases.find((r) => !r.draft && !r.prerelease && /^v\d+\.\d+\.\d+$/.test(r.tag_name))
        : null;
      const stats: Stats = {
        version: release?.tag_name ?? null,
        stars: typeof repo?.stargazers_count === 'number' ? formatCount(repo.stargazers_count) : null,
        forks: typeof repo?.forks_count === 'number' ? formatCount(repo.forks_count) : null,
      };
      try {
        sessionStorage.setItem(KEY, JSON.stringify({ at: Date.now(), stats }));
      } catch {}
      apply(stats);
    } catch {}
  }

  refresh();
</script>
