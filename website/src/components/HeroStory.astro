  .hs-cap strong { max-width: 100%; color: #eeeae2; font-size: .7rem; font-weight: 500; overflow-wrap: anywhere; }
  .hs-cap small { color: #7d8279; font-size: .56rem; line-height: 1.3; }
  .hs-cap.is-on { border-style: solid; border-color: #f18453; background: #2b2622; transform: translateY(-2px); }
  .hs-kind { padding: .08rem .32rem; border-radius: .18rem; font-size: .55rem; letter-spacing: .03em; }
