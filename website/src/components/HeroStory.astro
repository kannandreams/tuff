---
// Preview-only: option 1 reworked around one use case (a support agent),
// with option 3's steps and a dashboard mock. Local dev only.
const docs = '/getting-started';

// One support agent, one capability of each kind. `out` is what each harness
// gets; null where Tuff installs nothing for that harness.
const caps = [
  {
    kind: 'skill', id: 'ticket-triage', from: 'written in the repo',
    what: 'how to classify, prioritise, and escalate a ticket',
    out: ['.claude/skills/', '.agents/skills/', '.cursor/skills/', 'reads .agents/skills/'],
    level: ['full', 'full', 'full', 'full'],
  },
  {
    kind: 'tool', id: 'order-lookup', from: 'scripts/ in the repo',
    what: 'returns an order’s status from the orders API',
    out: ['.claude/tools/', '.agents/tools/', '.cursor/tools/', null],
    level: ['full', 'full', 'full', 'none'],
  },
  {
    kind: 'mcp', id: 'linear', from: 'Tuff MCP catalog',
    what: 'files a bug for engineering when a ticket is a defect',
    out: ['.mcp.json', '.codex/config.toml', '.cursor/mcp.json', '.opencode/opencode.json'],
    level: ['full', 'full', 'full', 'full'],
  },
  {
    kind: 'hook', id: 'pii-guard', from: 'platform team, git',
    what: 'checks tool input for customer data before it runs',
    out: ['.claude/settings.json', '.codex/hooks.json', '.cursor/hooks.json', null],
    level: ['full', 'full', 'full', 'none'],
  },
  {
    kind: 'policy', id: 'support-guardrails', from: 'security team, pack',
    what: 'no reading .env, no deleting Linear issues, ask before git push',
    out: ['.claude/settings.json', '.codex/rules/tuff.rules', null, '.opencode/opencode.json'],
    level: ['full', 'partial', 'none', 'full'],
  },
];
const harnesses = ['claude', 'codex', 'cursor', 'opencode'];

const projects = [
  { name: 'support-agent', repo: 'acme/agents · apps/support-agent', harnesses: 'claude · codex · opencode', caps: 5, pack: '1.4.0', status: 'ok' },
  { name: 'billing-agent', repo: 'acme/agents · apps/billing-agent', harnesses: 'claude · opencode', caps: 7, pack: '2.1.0', status: 'drift' },
  { name: 'onboarding-agent', repo: 'acme/onboarding', harnesses: 'codex · cursor', caps: 4, pack: '0.9.2', status: 'gap' },
  { name: 'infra-agent', repo: 'acme/infra', harnesses: 'claude · codex', caps: 9, pack: '3.0.0', status: 'ok' },
];
---

<section class="tuff-hero hs" data-hero-variant="4" hidden>
  <div class="tuff-hero-main hs-main">
    <h1 class="tuff-wordmark">t<span>u</span>ff</h1>
    <div class="hs-headlines">
      <div class="hs-roll" data-hs-headline="e">
        <h2 class="hs-roll-window" aria-live="polite">
          <span class="hs-roll-track">
            <span class="hs-roll-item" data-hs-line="0"><b>01</b><em>Bring your capabilities together.</em></span>
            <span class="hs-roll-item" data-hs-line="1"><b>02</b><em>Use them across harnesses.</em></span>
            <span class="hs-roll-item" data-hs-line="2"><b>03</b><em>Ship them with your agent.</em></span>
            <span class="hs-roll-item" data-hs-line="3"><b>04</b><em>Govern them everywhere.</em></span>
          </span>
        </h2>
        <ol class="hs-roll-steps" aria-hidden="true">
          <li data-hs-line="0"><i></i>bring</li>
          <li data-hs-line="1"><i></i>use</li>
          <li data-hs-line="2"><i></i>ship</li>
          <li data-hs-line="3"><i></i>govern</li>
        </ol>
      </div>
      <h2 class="hs-hl" data-hs-headline="a" hidden>
        <span data-hs-line="0"><b>01</b>Bring your capabilities together.</span>
        <span data-hs-line="1"><b>02</b>Use them across harnesses.</span>
        <span data-hs-line="2"><b>03</b>Ship them with your agent.</span>
        <span data-hs-line="3"><b>04</b>Govern them everywhere.</span>
      </h2>
      <h2 class="hs-hl" data-hs-headline="b" hidden>
        <span data-hs-line="0"><b>01</b>One set of capabilities.</span>
        <span data-hs-line="1"><b>02</b>Every coding agent.</span>
        <span data-hs-line="2"><b>03</b>Every agent you ship.</span>
        <span data-hs-line="3"><b>04</b>One view of all of it.</span>
      </h2>
      <h2 class="hs-hl hs-hl--compact" data-hs-headline="c" hidden>
        <span class="hs-hl-lead">Your agents’ capabilities, managed like code.</span>
        <span data-hs-line="0"><b>01</b>write</span>
        <span data-hs-line="1"><b>02</b>code</span>
        <span data-hs-line="2"><b>03</b>ship</span>
        <span data-hs-line="3"><b>04</b>govern</span>
      </h2>
      <h2 class="hs-hl" data-hs-headline="d" hidden>
        <span data-hs-line="0"><b>01</b>Build it once.</span>
        <span data-hs-line="1"><b>02</b>Run it in every harness.</span>
        <span data-hs-line="2"><b>03</b>Pack it with the agent.</span>
        <span data-hs-line="3"><b>04</b>See it across the organisation.</span>
      </h2>
    </div>
    <div class="tuff-hero-actions">
      <a class="tuff-button tuff-button--primary" href={docs}>Get started <span aria-hidden="true">→</span></a>
      <a class="tuff-button tuff-button--quiet" href="#hs-dashboard">See the dashboard</a>
    </div>
    <div class="hs-install">
      <span aria-hidden="true">$</span><code>uv tool install tuffcli</code>
      <button type="button" data-hs-copy="uv tool install tuffcli">copy</button>
    </div>
    <a class="hs-install-more" href="/getting-started/">brew, pip, cargo, and script installs</a>
  </div>

  <div class="tuff-hero-demo hs-demo">
    <figure class="hs-flow" data-hs-flow aria-label="A support agent's capabilities, from source to dashboard">
      <div class="hs-bar"><i></i><i></i><i></i><span>support-agent</span><em>github.com/acme/agents · apps/support-agent</em></div>

      <div class="hs-stage" data-hs-step="0" style="--d: 0">
        <div class="hs-label"><b>1</b> collect</div>
        <div class="hs-caps">
          {caps.map((cap, index) => (
            <button type="button" class="hs-cap" data-hs-cap={index}>
              <span class={`hs-kind hs-kind--${cap.kind}`}>{cap.kind}</span>
              <strong>{cap.id}</strong>
              <small>{cap.from}</small>
            </button>
          ))}
        </div>
      </div>

      <div class="hs-link" data-hs-step="0" style="--d: 1"><span>tuff add</span></div>

      <div class="hs-fork" style="--d: 2">
        <div class="hs-stage hs-path" data-hs-step="1">
          <div class="hs-label"><b>2</b> use while coding</div>
          <p class="hs-plain">Tuff writes each capability in the format each coding agent reads, and records it once in <code>tuff.lock</code>.</p>
          <ul class="hs-chips">
            {['Claude Code', 'Codex', 'Cursor', 'OpenCode'].map((product, col) => <li style={`--c: ${col}`}><i></i>{product}</li>)}
          </ul>
          <div class="hs-lock"><strong>tuff.lock</strong><span>one record for all of them</span></div>
        </div>
        <div class="hs-stage hs-path hs-path--ship" data-hs-step="2">
          <div class="hs-label"><b>3</b> ship with your agent</div>
          <p class="hs-plain">Tuff packs them into one versioned bundle that goes into the agent’s image and runs on an agent SDK.</p>
          <div class="hs-packline">
            <div class="hs-packbox">
              <strong>support-agent 1.4.0</strong>
              <code>sha256:9f2c…e41a</code>
            </div>
            <span class="hs-arrow" aria-hidden="true"></span>
            <ul class="hs-chips hs-chips--runtime">
              <li style="--c: 0"><i></i>Claude Agent SDK</li>
              <li style="--c: 1"><i></i>your own runtime</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="hs-merge" data-hs-step="3" style="--d: 3"><span>tuff dashboard publish</span></div>

      <div class="hs-stage hs-govern" data-hs-step="3" style="--d: 4">
        <div class="hs-label"><b>4</b> govern</div>
        <div class="hs-govern-body">
          <div class="hs-kpis">
            <div><b>12</b><small>projects</small></div>
            <div><b>86</b><small>capabilities</small></div>
            <div><b class="is-warn">2</b><small>drifted</small></div>
            <div><b class="is-gap">1</b><small>policy gap</small></div>
          </div>
          <ul class="hs-feed">
            <li><i class="is-add"></i>linear added to <b>support-agent</b><small>3f2c9e1</small></li>
            <li><i class="is-ver"></i>pack <b>support-agent</b> 1.3.0 → 1.4.0<small>image v42</small></li>
            <li><i class="is-warn"></i>ticket-triage edited in <b>billing-agent</b><small>drift</small></li>
          </ul>
        </div>
      </div>
    </figure>
  </div>

</section>

<section class="tuff-section hs-dash-section" id="hs-dashboard" data-hero-variant="4" hidden>
  <div class="tuff-section-head">
    <div class="tuff-section-label">//dashboard</div>
    <h2>Every agent’s capabilities, across the organisation</h2>
    <p>Projects publish a report from CI. The dashboard shows each agent’s skills, tools, MCP servers, hooks, and policies, which harness runs them, what changed, and when.</p>
  </div>

  <div class="hs-app" aria-label="Dashboard preview with sample data">
    <div class="hs-app-bar"><i></i><i></i><i></i><span>tuff dashboard</span><em>tuff.acme.internal</em></div>
    <div class="hs-app-body">
      <nav class="hs-app-nav" aria-label="Dashboard sections (sample)">
        <span class="is-active">Overview</span>
        <span>Projects</span>
        <span>Capabilities</span>
        <span>Harnesses</span>
        <span>Policies</span>
        <span>Audit</span>
      </nav>
      <div class="hs-app-main">
        <div class="hs-app-kpis">
          <div><small>projects</small><b>12</b><em>3 repositories</em></div>
          <div><small>capabilities</small><b>86</b><em>5 kinds</em></div>
          <div><small>drifted</small><b class="is-warn">2</b><em>since last report</em></div>
          <div><small>policy gaps</small><b class="is-gap">1</b><em>rule not enforced</em></div>
        </div>

        <div class="hs-app-grid">
          <div class="hs-card">
            <div class="hs-card-head">Projects</div>
            <div class="hs-ptable">
              <div class="hs-prow hs-prow--head"><span>agent</span><span>harnesses</span><span>caps</span><span>pack</span><span>status</span></div>
              {projects.map((project) => (
                <div class="hs-prow">
                  <span><strong>{project.name}</strong><small>{project.repo}</small></span>
                  <span>{project.harnesses}</span>
                  <span>{project.caps}</span>
                  <span>{project.pack}</span>
                  <span class={`hs-status hs-status--${project.status}`}>{project.status}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="hs-card">
            <div class="hs-card-head">Capability: <b>linear</b> <span class="hs-kind hs-kind--mcp">mcp</span></div>
            <div class="hs-usage">
              <div><span>used by</span><b>6 projects</b></div>
              <div><span>versions</span><b>1.0.0 ×5 · 0.9.0 ×1</b></div>
              <div><span>harnesses</span><b>claude · codex · opencode</b></div>
            </div>
            <div class="hs-bars" aria-hidden="true">
              <div style="--w: 100%"><span>claude</span></div>
              <div style="--w: 67%"><span>codex</span></div>
              <div style="--w: 50%"><span>opencode</span></div>
              <div style="--w: 17%"><span>cursor</span></div>
            </div>
          </div>

          <div class="hs-card hs-card--wide">
            <div class="hs-card-head">Audit trail</div>
            <ol class="hs-audit">
              <li><time>09:12</time><i class="is-add"></i><span><b>support-agent</b> added mcp <b>linear</b> for claude, codex, opencode</span><code>3f2c9e1</code></li>
              <li><time>08:47</time><i class="is-ver"></i><span><b>infra-agent</b> moved pack <b>platform-base</b> 2.0.0 → 3.0.0</span><code>a91d0c4</code></li>
              <li><time>08:30</time><i class="is-warn"></i><span><b>billing-agent</b> skill <b>ticket-triage</b> no longer matches its baseline</span><code>77be210</code></li>
              <li><time>Tue</time><i class="is-gap"></i><span><b>onboarding-agent</b> policy <b>support-guardrails</b> rule 2 not enforced in cursor</span><code>c03f5aa</code></li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Walk the flow one step at a time and light the matching headline line.
  // Hovering the flow holds the current step.
  document.querySelectorAll<HTMLElement>('.hs').forEach((hero) => {
    const flow = hero.querySelector<HTMLElement>('[data-hs-flow]');
    if (!flow) return;
    const parts = [...hero.querySelectorAll<HTMLElement>('[data-hs-step]')];
    const lines = [...hero.querySelectorAll<HTMLElement>('[data-hs-line]')];
    const steps = 4;
    let current = 0;
    let paused = false;
    const show = (step: number) => {
      current = step;
      hero.style.setProperty('--hs-step', String(step));
      flow.classList.add('is-stepping');
      parts.forEach((part) => part.classList.toggle('is-active', Number(part.dataset.hsStep) === step));
      lines.forEach((line) => line.classList.toggle('is-on', Number(line.dataset.hsLine) === step));
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      lines.forEach((line) => line.classList.add('is-on'));
      return;
    }
    flow.addEventListener('mouseenter', () => { paused = true; });
    flow.addEventListener('mouseleave', () => { paused = false; });
    setTimeout(() => {
      show(0);
      setInterval(() => {
        if (!paused && !document.hidden) show((current + 1) % steps);
      }, 2400);
    }, 1600);
  });

  document.querySelectorAll<HTMLButtonElement>('[data-hs-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.hsCopy ?? '');
      button.textContent = 'copied';
      setTimeout(() => { button.textContent = 'copy'; }, 1200);
    });
  });

  // Preview only: pick a headline with ?headline=a|b|c|d.
  const headline = new URL(location.href).searchParams.get('headline') ?? 'e';
  document.querySelectorAll<HTMLElement>('[data-hs-headline]').forEach((block) => {
    block.hidden = block.dataset.hsHeadline !== headline;
  });
</script>

<style>
  .hs, .hs-dash-section { --g: #4a7a5e; --g-dark: #83b477; --g-soft: rgba(131, 180, 119, .14); }
  :global([data-green='sage']) :is(.hs, .hs-dash-section) { --g: #5f8f72; --g-dark: #9cc7a3; --g-soft: rgba(156, 199, 163, .15); }
  :global([data-green='pine']) :is(.hs, .hs-dash-section) { --g: #2f6b58; --g-dark: #5fb39a; --g-soft: rgba(95, 179, 154, .15); }
  :global([data-green='off']) :is(.hs, .hs-dash-section) { --g: var(--tuff-accent); --g-dark: #f18453; --g-soft: rgba(241, 132, 83, .12); }
  .hs { grid-template-columns: minmax(0, .66fr) minmax(0, 1.34fr); column-gap: 2.5rem; align-items: center; padding-top: 3rem; padding-bottom: 2.75rem; }
  .hs-main { padding-top: 0; }
  .hs-headlines { margin-top: 1.4rem; }
  .hs-hl { display: grid; gap: .15rem; margin: 0; color: var(--tuff-text); font-family: 'Geist', system-ui, sans-serif; font-size: clamp(1.25rem, 2.1vw, 1.7rem); font-weight: 600; line-height: 1.3; letter-spacing: -.04em; }
  .hs-hl span { display: flex; align-items: baseline; gap: .6rem; color: var(--tuff-text); white-space: nowrap; }
  .hs-hl span b { position: relative; min-width: 1.6rem; color: var(--tuff-muted); font-family: 'JetBrains Mono', monospace; font-size: .62rem; font-weight: 500; letter-spacing: 0; transition: color .4s ease; }
  .hs-hl span.is-on b { color: var(--tuff-accent); }
  .hs-hl span:is([data-hs-line='1'], [data-hs-line='3']).is-on b { color: var(--g); }
  .hs-hl span:is([data-hs-line='1'], [data-hs-line='3']) b::before { background: var(--g); }
  .hs :global(.tuff-button--quiet:hover) { border-color: var(--g); color: var(--g); }
  .hs-hl span b::before { content: ''; position: absolute; left: -.7rem; top: 50%; width: .35rem; height: .35rem; border-radius: 50%; background: var(--tuff-accent); opacity: 0; transform: translateY(-50%) scale(.4); transition: opacity .3s ease, transform .3s ease; }
  .hs-hl span.is-on b::before { opacity: 1; transform: translateY(-50%) scale(1); }
  .hs-hl--compact { gap: .35rem; }
  .hs-hl--compact .hs-hl-lead { display: block; margin-bottom: .6rem; color: var(--tuff-text); }
  .hs-hl--compact span[data-hs-line] { display: inline-flex; font-family: 'JetBrains Mono', monospace; font-size: 1rem; letter-spacing: 0; }
  .hs-install { display: flex; align-items: center; gap: .6rem; max-width: 22rem; margin-top: 1.4rem; padding: .75rem .9rem; border: 1px solid #343934; border-radius: .4rem; background: #1b1e1b; box-shadow: 0 1rem 2.5rem rgba(38, 31, 22, .1); font-family: 'JetBrains Mono', monospace; font-size: .85rem; }
  .hs-install > span { color: var(--g-dark); }
  .hs-install code { flex: 1; color: #eeeae2; font-family: inherit; white-space: nowrap; }
  .hs-install button { padding: .2rem .4rem; border: 1px solid #343934; border-radius: .2rem; color: #989d94; background: transparent; cursor: pointer; font: inherit; font-size: .64rem; }
  .hs-install button:hover { color: #f18453; border-color: #9a4c30; }
  .hs-install-more { display: inline-block; margin-top: .5rem; color: var(--tuff-muted); font-family: 'JetBrains Mono', monospace; font-size: .66rem; }
  .hs-install-more:hover { color: var(--tuff-accent); }
  .hs-hl[hidden], .hs-roll[hidden] { display: none; }
  .hs-roll { --hs-line: 2.5em; margin-top: .2rem; }
  .hs-roll-window { height: var(--hs-line); margin: 0; overflow: hidden; font-family: 'Geist', system-ui, sans-serif; font-size: clamp(1.6rem, 2.9vw, 2.35rem); font-weight: 600; line-height: 1.2; letter-spacing: -.045em; }
  .hs-roll-track { display: block; transform: translateY(calc(var(--hs-step, 0) * var(--hs-line) * -1)); transition: transform .7s cubic-bezier(.65, 0, .25, 1); }
  .hs-roll-item { display: flex; align-items: flex-start; gap: .55rem; height: var(--hs-line); color: var(--tuff-text); opacity: .15; transition: opacity .5s ease; }
  .hs-roll-item.is-on { opacity: 1; }
  .hs-roll-item b { flex: none; margin-top: .55em; color: var(--tuff-accent); font-family: 'JetBrains Mono', monospace; font-size: .32em; font-weight: 500; letter-spacing: 0; }
  .hs-roll-item:is([data-hs-line='1'], [data-hs-line='3']) b { color: var(--g); }
  .hs-roll-item em { max-width: 11.5em; font-style: normal; }
  .hs-roll-steps { display: flex; gap: .35rem; margin: .9rem 0 0; padding: 0; list-style: none; font-family: 'JetBrains Mono', monospace; font-size: .64rem; }
  .hs-roll-steps li { display: flex; flex-direction: column; gap: .35rem; width: 4.6rem; color: var(--tuff-muted); transition: color .4s ease; }
  .hs-roll-steps i { height: 3px; border-radius: 2px; background: var(--tuff-border); overflow: hidden; position: relative; }
  .hs-roll-steps i::after { content: ''; position: absolute; inset: 0; background: var(--tuff-accent); transform: scaleX(0); transform-origin: left; }
  .hs-roll-steps li:is([data-hs-line='1'], [data-hs-line='3']) i::after { background: var(--g); }
  .hs-roll-steps li.is-on { color: var(--tuff-text); }
  .hs-roll-steps li.is-on i::after { animation: hs-fill 2.4s linear forwards; }
  @keyframes hs-fill { to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) {
    .hs-roll-window { height: auto; }
    .hs-roll-track { transform: none; }
    .hs-roll-item { opacity: 1; height: auto; }
    .hs-roll-steps { display: none; }
  }

  .hs-flow { margin: 0; padding: 0 1rem .8rem; border: 1px solid #343934; border-radius: .5rem; background: #1b1e1b; color: #eeeae2; box-shadow: 0 2rem 5rem rgba(38, 31, 22, .2), 0 0 0 1px rgba(232, 93, 42, .08); font-family: 'JetBrains Mono', monospace; }
  .hs-bar { display: flex; align-items: center; gap: .4rem; margin: 0 -1rem .7rem; padding: .6rem 1rem; border-bottom: 1px solid #343934; background: #242824; border-radius: .5rem .5rem 0 0; font-size: .68rem; }
