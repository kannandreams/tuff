---
// Preview-only hero variations (local dev). Each variant replaces the hero's
// left column and demo; the install tabs move below the story.
const docs = '/getting-started';

const dashboardRows = [
  { project: 'apps/support-agent', harnesses: 'claude · codex', caps: 9, status: 'ok' },
  { project: 'apps/billing-agent', harnesses: 'claude · opencode', caps: 7, status: 'drift' },
  { project: 'acme/infra-agent', harnesses: 'codex · cursor', caps: 5, status: 'gap' },
];
---

<!-- Variant 1: From scattered to governed -->
<section class="tuff-hero hv" data-hero-variant="1" hidden>
  <div class="tuff-hero-main">
    <h1 class="tuff-wordmark">t<span>u</span>ff</h1>
    <p class="hv-kicker">From scattered to governed</p>
    <p class="hv-headline">Every capability your agents run, managed from first line to fleet view.</p>
    <p class="tuff-hero-copy">
      Your agents run on skills, MCP servers, hooks, and policies, written in-house or pulled from anywhere.
      Tuff brings them into one place, compiles each for Claude Code, Codex, Cursor, and OpenCode, packs them
      with the agent that needs them, and shows every project's capabilities on one dashboard.
    </p>
    <div class="tuff-hero-actions">
      <a class="tuff-button tuff-button--primary" href={docs}>Get started <span aria-hidden="true">→</span></a>
      <a class="tuff-button tuff-button--quiet" href="#hv-dashboard">See the dashboard</a>
    </div>
    <p class="hv-install"><span>$</span> uv tool install tuffcli</p>
  </div>

  <div class="tuff-hero-demo">
    <div class="hv-flow" aria-label="How Tuff moves capabilities from sources to a governed fleet">
      <div class="hv-flow-row">
        <div class="hv-flow-label">sources</div>
        <div class="hv-scatter">
          <span class="hv-cap" style="--r: -3deg"><b>skill</b> refund-policy <small>written in repo</small></span>
          <span class="hv-cap" style="--r: 2deg"><b>mcp</b> github <small>catalog</small></span>
          <span class="hv-cap" style="--r: -1deg"><b>hook</b> lint-first <small>git</small></span>
          <span class="hv-cap" style="--r: 3deg"><b>policy</b> guardrails <small>platform team</small></span>
        </div>
      </div>
      <div class="hv-arrow"><span>tuff add · tuff create</span></div>
      <div class="hv-flow-row hv-core">
        <div class="hv-flow-label">tuff.lock</div>
        <div class="hv-core-body">
          <span>tracked</span><span>versioned</span><span>drift-checked</span>
        </div>
      </div>
      <div class="hv-arrow"><span>compiled for each harness</span></div>
      <div class="hv-flow-row">
        <div class="hv-flow-label">harnesses</div>
        <div class="hv-harness-grid">
          <span><b>claude</b>.claude/</span>
          <span><b>codex</b>.codex/</span>
          <span><b>cursor</b>.cursor/</span>
          <span><b>opencode</b>.opencode/</span>
        </div>
      </div>
      <div class="hv-arrow"><span>tuff pack build</span></div>
      <div class="hv-flow-split">
        <div class="hv-pack">
          <div class="hv-flow-label">pack</div>
          <strong>support-agent 1.4.0</strong>
          <code>sha256:9f2c…e41a</code>
          <small>ships with the agent</small>
        </div>
        <div class="hv-dash-mini" id="hv-dashboard">
          <div class="hv-flow-label">dashboard</div>
          <div class="hv-dash-counts"><span><b>12</b> projects</span><span><b>2</b> drifted</span><span><b>1</b> gap</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Variant 2: Build an agent's toolkit once -->
<section class="tuff-hero hv" data-hero-variant="2" hidden>
  <div class="tuff-hero-main">
    <h1 class="tuff-wordmark">t<span>u</span>ff</h1>
    <p class="hv-kicker">Build an agent's toolkit once</p>
    <p class="hv-headline">Write it once. Run it in every harness. Ship it with the agent.</p>
    <p class="tuff-hero-copy">
      Write a skill. Add an MCP server. Set a policy. Tuff tracks each one, installs it for every harness your
      team uses, and bundles the set into a pack that ships with your agent. The dashboard shows which agent
      carries what, at which version, everywhere.
    </p>
    <div class="tuff-hero-actions">
      <a class="tuff-button tuff-button--primary" href={docs}>Get started <span aria-hidden="true">→</span></a>
      <a class="tuff-hero-link" href="/concepts/packs/">How packs work</a>
    </div>
    <p class="hv-install"><span>$</span> uv tool install tuffcli</p>
  </div>

  <div class="tuff-hero-demo hv-stack">
    <div class="tuff-terminal" aria-label="Building an agent's toolkit with Tuff">
      <div class="tuff-term-bar"><i></i><i></i><i></i><span>~/agents/apps/support-agent</span></div>
      <div class="tuff-term-body">
        <div style="--i: 0"><b>$</b> tuff create skill refund-policy</div>
        <div style="--i: 1" class="tuff-output tuff-output--ok">tracked .agents/skills/refund-policy</div>
        <div style="--i: 2"><b>$</b> tuff add mcp github -a claude -a codex</div>
        <div style="--i: 3" class="tuff-output">registered github → <mark>.mcp.json</mark>, <mark>.codex/config.toml</mark></div>
        <div style="--i: 4"><b>$</b> tuff add ./policies/guardrails -a claude -a opencode</div>
        <div style="--i: 5" class="tuff-output">compiled 3 rules → <mark>.claude/settings.json</mark>, <mark>.opencode/opencode.json</mark></div>
        <div style="--i: 6"><b>$</b> tuff pack build --name support-agent</div>
        <div style="--i: 7" class="tuff-output tuff-output--ok">built support-agent-1.4.0.tuffpack</div>
        <div style="--i: 8"><b>$</b> tuff dashboard publish</div>
        <div style="--i: 9" class="tuff-output tuff-output--aqua">reported github.com/acme/agents · apps/support-agent</div>
      </div>
    </div>
    <div class="hv-table" aria-label="Dashboard preview">
      <div class="hv-table-head"><span>agent</span><span>harnesses</span><span>capabilities</span><span>status</span></div>
      {dashboardRows.map((row) => (
        <div class="hv-table-row">
          <span>{row.project}</span><span>{row.harnesses}</span><span>{row.caps}</span>
          <span class={`hv-status hv-status--${row.status}`}>{row.status}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Variant 3: The lifecycle, told as steps -->
<section class="tuff-hero hv hv--steps" data-hero-variant="3" hidden>
  <div class="tuff-hero-main">
    <h1 class="tuff-wordmark">t<span>u</span>ff</h1>
    <p class="hv-headline hv-headline--big">Your agent's capabilities, from first draft to audited fleet.</p>
    <p class="tuff-hero-copy">
      Skills, tools, MCP servers, hooks, and policies, managed like code: written once, compiled for every
      harness, packed with the agent, and visible across every project.
    </p>
    <div class="tuff-hero-actions">
      <a class="tuff-button tuff-button--primary" href={docs}>Get started <span aria-hidden="true">→</span></a>
      <a class="tuff-hero-link" href="/intro/#why-tuff-exists">Why Tuff exists</a>
    </div>
    <p class="hv-install"><span>$</span> uv tool install tuffcli</p>
  </div>

  <div class="tuff-hero-demo">
    <div class="hv-dash" aria-label="Dashboard preview">
      <div class="hv-dash-bar"><i></i><i></i><i></i><span>tuff dashboard · acme</span></div>
      <div class="hv-dash-body">
        <div class="hv-dash-stats">
          <div><small>projects</small><b>12</b></div>
          <div><small>capabilities</small><b>86</b></div>
          <div><small>drifted</small><b class="is-warn">2</b></div>
          <div><small>policy gaps</small><b class="is-gap">1</b></div>
        </div>
        <div class="hv-table hv-table--light">
          <div class="hv-table-head"><span>project</span><span>harnesses</span><span>caps</span><span>status</span></div>
          {dashboardRows.map((row) => (
            <div class="hv-table-row">
              <span>{row.project}</span><span>{row.harnesses}</span><span>{row.caps}</span>
              <span class={`hv-status hv-status--${row.status}`}>{row.status}</span>
            </div>
          ))}
        </div>
        <div class="hv-events">
          <div><i class="is-add"></i> github mcp added to <b>billing-agent</b> <small>3f2c9e1 · 2h</small></div>
          <div><i class="is-warn"></i> refund-policy edited in <b>billing-agent</b> <small>drift · 40m</small></div>
        </div>
      </div>
    </div>
  </div>

  <ol class="hv-steps">
    <li>
      <b>01</b><strong>Collect</strong>
      <p>Create or import skills, tools, MCP servers, hooks, and policies. Each one is tracked in <code>tuff.lock</code>.</p>
      <div class="hv-tags"><span>skill</span><span>tool</span><span>mcp</span><span>hook</span><span>policy</span></div>
    </li>
    <li>
      <b>02</b><strong>Compile</strong>
      <p>One definition becomes each harness's native files, with an honest note where a harness falls short.</p>
      <div class="hv-tags"><span>.claude/</span><span>.codex/</span><span>.cursor/</span><span>.opencode/</span></div>
    </li>
    <li class="is-pack">
      <b>03</b><strong>Pack</strong>
      <p>Bundle them into a versioned, verified pack that travels with the agent, through OCI or as a file.</p>
      <div class="hv-tags"><span>support-agent 1.4.0</span><span>sha256 pinned</span></div>
    </li>
    <li>
      <b>04</b><strong>Govern</strong>
      <p>Every project reports in. One dashboard shows what runs where, what drifted, and what changed.</p>
      <div class="hv-tags"><span>12 projects</span><span>audit trail</span></div>
    </li>
  </ol>
</section>

<style>
  .hv-kicker { margin-top: 1.4rem !important; color: var(--tuff-accent); font-family: 'JetBrains Mono', monospace; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
  .hv-headline { max-width: 36rem; margin-top: .55rem !important; color: var(--tuff-text); font-size: clamp(1.35rem, 3vw, 1.95rem); line-height: 1.18; letter-spacing: -.04em; font-weight: 600; }
  .hv-headline--big { margin-top: 1.45rem !important; font-size: clamp(1.6rem, 3.6vw, 2.4rem); }
  .hv-install { display: inline-flex; gap: .5rem; margin-top: 1.25rem !important; padding: .45rem .7rem; border: 1px solid var(--tuff-border); border-radius: .3rem; color: var(--tuff-text); background: rgba(255, 255, 255, .7); font-family: 'JetBrains Mono', monospace; font-size: .75rem; }
  .hv-install span { color: var(--tuff-muted); }

  /* Variant 1: flow */
  .hv-flow { padding: 1.1rem; border: 1px solid #343934; border-radius: .4rem; background: #1b1e1b; color: #eeeae2; box-shadow: 0 2rem 5rem rgba(38, 31, 22, .18); font-family: 'JetBrains Mono', monospace; }
  .hv-flow-row { padding: .75rem; border: 1px solid #343934; border-radius: .3rem; background: #242824; }
  .hv-flow-label { margin-bottom: .55rem; color: #989d94; font-size: .58rem; letter-spacing: .08em; text-transform: uppercase; }
  .hv-scatter { display: flex; flex-wrap: wrap; gap: .45rem; }
  .hv-cap { display: inline-flex; align-items: baseline; gap: .35rem; padding: .35rem .5rem; border: 1px dashed #4c544c; border-radius: .25rem; background: #1b1e1b; font-size: .66rem; transform: rotate(var(--r, 0deg)); }
  .hv-cap b { color: #f18453; font-weight: 500; }
  .hv-cap small { color: #7d8279; font-size: .56rem; }
  .hv-arrow { position: relative; display: flex; justify-content: center; height: 1.6rem; }
  .hv-arrow::before { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 1px; background: #4c544c; }
  .hv-arrow span { position: relative; align-self: center; padding: 0 .45rem; color: #989d94; background: #1b1e1b; font-size: .56rem; }
  .hv-core { border-color: #9a4c30; background: linear-gradient(145deg, #2b2925, #242824); }
  .hv-core-body { display: flex; gap: .45rem; }
  .hv-core-body span { padding: .25rem .45rem; border-radius: .2rem; color: #83b477; background: rgba(131, 180, 119, .1); font-size: .62rem; }
  .hv-harness-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .4rem; }
  .hv-harness-grid span { display: flex; flex-direction: column; gap: .15rem; padding: .4rem; border: 1px solid #343934; border-radius: .22rem; background: #1b1e1b; color: #989d94; font-size: .58rem; }
  .hv-harness-grid b { color: #eeeae2; font-weight: 500; font-size: .66rem; }
  .hv-flow-split { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
  .hv-pack, .hv-dash-mini { padding: .75rem; border: 1px solid #343934; border-radius: .3rem; background: #242824; }
  .hv-pack { border-color: #9a4c30; }
  .hv-pack strong { display: block; color: #f18453; font-size: .74rem; font-weight: 500; }
  .hv-pack code { display: block; margin-top: .3rem; color: #c9ccc5; font-size: .6rem; }
  .hv-pack small { display: block; margin-top: .4rem; color: #989d94; font-size: .56rem; }
  .hv-dash-counts { display: grid; gap: .3rem; font-size: .64rem; color: #aeb1aa; }
  .hv-dash-counts b { color: #eeeae2; }

  /* Variant 2: terminal + table */
  .hv-stack { display: grid; gap: .9rem; }
  .hv-table { overflow: hidden; border: 1px solid var(--tuff-border); border-radius: .35rem; background: var(--tuff-panel); font-family: 'JetBrains Mono', monospace; font-size: .64rem; box-shadow: 0 1rem 2.5rem rgba(38, 31, 22, .08); }
  .hv-table-head, .hv-table-row { display: grid; grid-template-columns: 1.6fr 1.3fr .8fr .6fr; gap: .5rem; padding: .5rem .75rem; }
  .hv-table-head { color: var(--tuff-muted); background: var(--tuff-panel-2); font-size: .58rem; letter-spacing: .05em; text-transform: uppercase; }
  .hv-table-row { border-top: 1px solid var(--tuff-border); color: var(--tuff-text); }
  .hv-status { justify-self: start; padding: .08rem .35rem; border-radius: .2rem; font-size: .58rem; }
  .hv-status--ok { color: var(--tuff-green); background: rgba(74, 122, 94, .1); }
  .hv-status--drift { color: #a86a12; background: rgba(214, 150, 40, .14); }
  .hv-status--gap { color: var(--tuff-accent); background: rgba(195, 90, 53, .1); }

  /* Variant 3: dashboard + steps */
  .hv-dash { overflow: hidden; border: 1px solid var(--tuff-border); border-radius: .45rem; background: var(--tuff-bg); box-shadow: 0 2rem 5rem rgba(38, 31, 22, .16), 0 0 0 1px rgba(232, 93, 42, .06); }
  .hv-dash-bar { display: flex; align-items: center; gap: .4rem; padding: .6rem .85rem; border-bottom: 1px solid var(--tuff-border); color: var(--tuff-muted); background: var(--tuff-panel-2); font-family: 'JetBrains Mono', monospace; font-size: .64rem; }
  .hv-dash-bar i { width: .46rem; height: .46rem; border: 1px solid #c9c3b9; border-radius: 50%; }
  .hv-dash-bar span { margin-left: .45rem; }
  .hv-dash-body { display: grid; gap: .8rem; padding: .9rem; }
  .hv-dash-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: .5rem; }
  .hv-dash-stats div { padding: .55rem .6rem; border: 1px solid var(--tuff-border); border-radius: .3rem; background: var(--tuff-panel); }
  .hv-dash-stats small { display: block; color: var(--tuff-muted); font-family: 'JetBrains Mono', monospace; font-size: .56rem; }
  .hv-dash-stats b { color: var(--tuff-text); font-family: 'JetBrains Mono', monospace; font-size: 1.15rem; }
  .hv-dash-stats b.is-warn { color: #a86a12; }
  .hv-dash-stats b.is-gap { color: var(--tuff-accent); }
  .hv-table--light { box-shadow: none; }
  .hv-events { display: grid; gap: .35rem; font-size: .7rem; color: var(--tuff-dim); }
  .hv-events i { display: inline-block; width: .42rem; height: .42rem; margin-right: .35rem; border-radius: 50%; }
  .hv-events i.is-add { background: var(--tuff-green); }
  .hv-events i.is-warn { background: #d69628; }
  .hv-events b { color: var(--tuff-text); font-weight: 600; }
  .hv-events small { margin-left: .35rem; color: var(--tuff-muted); font-family: 'JetBrains Mono', monospace; font-size: .58rem; }
  .hv-steps { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin: 0; padding: 0; overflow: hidden; border: 1px solid var(--tuff-border); border-radius: .4rem; background: var(--tuff-border); list-style: none; counter-reset: none; }
  .hv-steps li { position: relative; padding: 1.1rem 1.1rem 1.2rem; background: var(--tuff-panel); }
  .hv-steps li:not(:last-child)::after { content: '›'; position: absolute; top: 1rem; right: .6rem; color: var(--tuff-accent); font-size: 1.1rem; }
  .hv-steps li.is-pack { background: linear-gradient(160deg, rgba(232, 93, 42, .07), var(--tuff-panel) 60%); }
  .hv-steps b { color: var(--tuff-muted); font-family: 'JetBrains Mono', monospace; font-size: .66rem; font-weight: 400; }
  .hv-steps strong { display: block; margin-top: .35rem; color: var(--tuff-text); font-family: 'JetBrains Mono', monospace; font-size: 1rem; }
  .hv-steps p { margin-top: .45rem !important; color: var(--tuff-dim); font-size: .82rem; line-height: 1.55; }
  .hv-steps code { font-family: 'JetBrains Mono', monospace; font-size: .74rem; color: var(--tuff-text); }
  .hv-tags { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .7rem; }
  .hv-tags span { padding: .18rem .4rem; border: 1px solid var(--tuff-border); border-radius: .2rem; color: var(--tuff-dim); background: var(--tuff-bg); font-family: 'JetBrains Mono', monospace; font-size: .58rem; }

  @media (max-width: 900px) {
    .hv-steps { grid-template-columns: 1fr 1fr; }
    .hv-harness-grid { grid-template-columns: repeat(2, 1fr); }
    .hv-dash-stats { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .hv-steps, .hv-flow-split { grid-template-columns: 1fr; }
    .hv-table-head, .hv-table-row { grid-template-columns: 1.6fr .6fr; }
    .hv-table-head span:nth-child(2), .hv-table-head span:nth-child(3),
    .hv-table-row span:nth-child(2), .hv-table-row span:nth-child(3) { display: none; }
  }
</style>
