---
// The built-in MCP catalog, listed from the same file the binary embeds.
//
// The data comes from src/data/mcp-catalog.json, which is generated from
// crates/tuff-core/assets/mcp-catalog.toml before every build. Nothing on
// this page is maintained by hand, so an entry added to the catalog appears
// here on the next build and a listing can never promise a server the CLI
// cannot install.
import catalog from "../data/mcp-catalog.json";

const entries = catalog.entries;
const keyless = entries.filter((entry) => !entry.needsKey).length;
const remote = entries.filter((entry) => entry.transport === "http").length;

const launcherLabel: Record<string, string> = {
  npm: "npx",
  python: "uvx",
  docker: "docker",
  remote: "https",
};
---

<div class="tuff-catalog" data-catalog>
  <div class="tuff-catalog-toolbar">
    <div class="tuff-catalog-search">
      <label class="tuff-catalog-search-label" for="catalog-search">Filter</label>
      <input
        id="catalog-search"
        type="search"
        placeholder="Search by name, purpose, or tool"
        autocomplete="off"
        data-catalog-search
      />
    </div>
    <div class="tuff-catalog-filters" role="group" aria-label="Filter the catalog">
      <button type="button" data-catalog-filter="all" aria-pressed="true">All {entries.length}</button>
      <button type="button" data-catalog-filter="keyless" aria-pressed="false">No key needed {keyless}</button>
      <button type="button" data-catalog-filter="key" aria-pressed="false">Needs a key {entries.length - keyless}</button>
      <button type="button" data-catalog-filter="remote" aria-pressed="false">Remote {remote}</button>
    </div>
  </div>

  <p class="tuff-catalog-count" role="status" data-catalog-count>
    Showing all {entries.length} servers.
  </p>

  <ul class="tuff-catalog-grid">
    {
      entries.map((entry) => (
        <li
          class="tuff-catalog-card"
          data-catalog-entry
          data-needs-key={String(entry.needsKey)}
          data-transport={entry.transport}
          data-haystack={`${entry.id} ${entry.description} ${entry.tools.join(" ")} ${entry.variables.join(" ")}`.toLowerCase()}
        >
          <div class="tuff-catalog-card-head">
            <strong>{entry.id}</strong>
            <span class="tuff-catalog-launcher">{launcherLabel[entry.launcher] ?? entry.launcher}</span>
          </div>
          <p class="tuff-catalog-description">{entry.description}</p>

          <div class="tuff-catalog-command">
            <code>tuff add mcp {entry.id}</code>
            <button type="button" data-catalog-copy={`tuff add mcp ${entry.id}`} aria-label={`Copy the install command for ${entry.id}`}>
              copy
            </button>
          </div>

          <dl class="tuff-catalog-meta">
            <div>
              <dt>Needs</dt>
              <dd>
                {entry.variables.length === 0 ? (
                  <span class="tuff-catalog-ok">nothing</span>
                ) : (
                  entry.variables.map((variable) => <code>{variable}</code>)
                )}
              </dd>
            </div>
            {entry.tools.length > 0 && (
              <div>
                <dt>Tools</dt>
                <dd class="tuff-catalog-tools">
                  {entry.tools.map((tool) => (
                    <code>{tool}</code>
                  ))}
                </dd>
              </div>
            )}
            <div>
              <dt>Runs</dt>
              <dd>
                <code class="tuff-catalog-run">{entry.command}</code>
              </dd>
            </div>
          </dl>
        </li>
      ))
    }
  </ul>

  <p class="tuff-catalog-empty" hidden data-catalog-empty>
    Nothing in the built-in catalog matches that. The wider MCP registry is reachable with
    <code>tuff mcp search</code>.
  </p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-catalog]");
  if (root) {
    const search = root.querySelector<HTMLInputElement>("[data-catalog-search]");
    const cards = [...root.querySelectorAll<HTMLElement>("[data-catalog-entry]")];
    const count = root.querySelector<HTMLElement>("[data-catalog-count]");
    const empty = root.querySelector<HTMLElement>("[data-catalog-empty]");
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-catalog-filter]")];
    let filter = "all";

    const matchesFilter = (card: HTMLElement) => {
      if (filter === "keyless") return card.dataset.needsKey === "false";
      if (filter === "key") return card.dataset.needsKey === "true";
      if (filter === "remote") return card.dataset.transport === "http";
      return true;
    };

    const apply = () => {
      const query = (search?.value ?? "").trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const haystack = card.dataset.haystack ?? "";
        const visible = matchesFilter(card) && (query === "" || haystack.includes(query));
        card.hidden = !visible;
        if (visible) shown += 1;
      }
      if (count) {
        count.textContent =
          shown === cards.length
            ? `Showing all ${cards.length} servers.`
            : `Showing ${shown} of ${cards.length} servers.`;
      }
      if (empty) empty.hidden = shown !== 0;
    };

    search?.addEventListener("input", apply);
    for (const button of buttons) {
      button.addEventListener("click", () => {
        filter = button.dataset.catalogFilter ?? "all";
        for (const other of buttons) {
          other.setAttribute("aria-pressed", String(other === button));
        }
        apply();
      });
    }

    root.addEventListener("click", (event) => {
      const button =
        event.target instanceof Element
          ? event.target.closest<HTMLButtonElement>("[data-catalog-copy]")
          : null;
      if (!button) return;
      const command = button.dataset.catalogCopy ?? "";
      navigator.clipboard?.writeText(command).then(
        () => {
          const original = button.textContent;
          button.textContent = "copied";
          setTimeout(() => {
            button.textContent = original;
          }, 1200);
        },
        () => {
          // Clipboard access can be refused; the command is selectable
          // text either way, so there is nothing to recover from.
        },
      );
    });
  }
</script>
