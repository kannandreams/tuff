---
// Starlight's header social links, with the GitHub icon replaced by the
// repository card. The other links (VS Code Marketplace, the blog's RSS
// feed) stay as icons. The GitHub entry is kept in astro.config.mjs so
// anything else reading `social` still sees it.
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import GitHubRepo from './GitHubRepo.astro';

const links = (config.social ?? []).filter((link) => link.icon !== 'github');
---

<GitHubRepo />
{
  links.map(({ label, href, icon }) => (
    <a href={href} rel="me" class="sl-flex tuff-social-icon">
      <span class="sr-only">{label}</span>
      <Icon name={icon} />
    </a>
  ))
}

<style>
  @layer starlight.core {
    .tuff-social-icon {
      color: var(--sl-color-text-accent);
      padding: 0.5em;
      margin: -0.5em;
    }
    .tuff-social-icon:hover {
      color: var(--sl-color-white);
    }
  }
</style>
