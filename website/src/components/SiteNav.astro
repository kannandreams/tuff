---
// The navigation shared by every standalone page (the landing page and the
// MCP catalog). Extracted so a link is added or removed in one place.
//
// `Packs` points at the landing page's anchor rather than a bare `#packs`,
// so it works from a page that does not contain that section.
interface Props {
  /** Href of the current page, so its link can be marked. */
  current?: string;
}

const { current } = Astro.props;

const links = [
  { href: '/getting-started', label: 'Docs' },
  { href: '/primitives/overview', label: 'Capabilities' },
  { href: '/mcp-catalog', label: 'MCP Catalog' },
  { href: '/#packs', label: 'Packs' },
  { href: '/concepts/adapters', label: 'Adapters' },
  { href: '/blog', label: 'Blog' },
];
---

<nav class="tuff-nav">
  <div class="tuff-nav-left">
    <a class="tuff-brand" href="/" aria-label="Tuff home">tuff</a>
    <div class="tuff-nav-links">
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.href === current ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
  <a class="tuff-github-button" href="https://github.com/kannandreams/tuff" aria-label="View Tuff on GitHub">
    View on GitHub
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.6-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z"/></svg>
  </a>
</nav>
