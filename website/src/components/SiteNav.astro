---
// The navigation shared by every standalone page (the landing page and the
// MCP catalog). Extracted so a link is added or removed in one place.
//
// `Packs` points at the landing page's anchor rather than a bare `#packs`,
// so it works from a page that does not contain that section.
//
// An `external` link leaves the site, so it opens in a new tab and never
// matches `current`.
//
// A link with an `icon` shows only the icon at mid widths, where the labels
// do not fit; its label stays for screen readers and as the tooltip.
import GitHubRepo from './GitHubRepo.astro';
import { navIcons } from '../lib/nav-icons';

interface Props {
  /** Href of the current page, so its link can be marked. */
  current?: string;
}

const { current } = Astro.props;

const links: { href: string; label: string; external?: boolean; icon?: string }[] = [
  { href: '/primitives/overview', label: 'Capabilities', icon: navIcons.puzzle },
  { href: '/mcp-catalog', label: 'MCP Catalog', icon: navIcons.server },
  { href: '/#packs', label: 'Packs', icon: navIcons.box },
  { href: '/#dashboard', label: 'Dashboard', icon: navIcons.dashboard },
  { href: '/concepts/adapters', label: 'Adapters', icon: navIcons.plug },
  { href: '/blog', label: 'Blog', icon: navIcons.pencil },
  {
    href: 'https://marketplace.visualstudio.com/items?itemName=kannandreams.tuff',
    label: 'VS Code Extension',
    external: true,
    icon: navIcons.vscode,
  },
];
---

<nav class="tuff-nav">
  <div class="tuff-nav-left">
    <a class="tuff-brand" href="/" aria-label="Tuff home">tuff</a>
    <div class="tuff-nav-links">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={link.href === current ? 'page' : undefined}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            title={link.icon ? link.label : undefined}
          >
            {link.icon && <svg viewBox="0 0 24 24" aria-hidden="true" set:html={link.icon} />}
            <span class="tuff-nav-label">{link.label}</span>
          </a>
        ))
      }
    </div>
  </div>
  <GitHubRepo class="tuff-repo--plain" />
</nav>
